#!/usr/bin/env bash
set -euo pipefail

# ------------------------------------------------------------------
# Root-only safety check
# ------------------------------------------------------------------
if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: This script must be run as root." >&2
    exit 1
fi

# ------------------------------------------------------------------
# Configuration
# ------------------------------------------------------------------
BASE_DIR="/opt/omero-test"
REPO_URL="git@github.com:strmt7/omero-zmb-omp-plugin.git"
REPO_BRANCH="test"
SCRIPT_NAME="github_pull_project"

# ------------------------------------------------------------------
# Workflow
# ------------------------------------------------------------------
cd "${BASE_DIR}"

echo "Backing up script..."
cp "${SCRIPT_NAME}" "/tmp/${SCRIPT_NAME}.backup"

COMPOSE_FILE="${BASE_DIR}/docker-compose.yml"

if [ -f "${COMPOSE_FILE}" ]; then
    echo "Stopping containers using ${COMPOSE_FILE}..."
    docker compose -f "${COMPOSE_FILE}" down
else
    echo "No docker-compose.yml found — skipping container shutdown."
fi

echo "Removing old omeroweb image..."
docker rmi omero-test-omeroweb 2>/dev/null || echo "Image already removed or doesn't exist"

echo "Removing all files except script..."
find . -mindepth 1 -maxdepth 1 ! -name "${SCRIPT_NAME}" -exec rm -rf {} +

echo "Cloning repository (test branch)..."
git clone -b "${REPO_BRANCH}" "${REPO_URL}" temp_clone
mv temp_clone/* temp_clone/.* . 2>/dev/null || true
rm -rf temp_clone

echo "Restoring script..."
mv "/tmp/${SCRIPT_NAME}.backup" "${SCRIPT_NAME}"

echo "Building Omero container (no cache)..."
docker compose build --no-cache omeroweb

echo "Starting containers..."
docker compose up -d

echo "Done."


