#!/usr/bin/env bash

# Configuration (change SCRIPT_NAME and BASE_DIR according to your preferences)
# -----------------------------------------------------------------------------
SCRIPT_NAME="github_pull_project"
DEFAULT_OMERO_INSTALLATION_PATH="/opt/omero/"
OMERO_INSTALLATION_PATH="${DEFAULT_OMERO_INSTALLATION_PATH}"
REPO_URL="git@github.com:strmt7/omero-zmb-omp-plugin.git"
REPO_BRANCH="test"
COMPOSE_FILE="${OMERO_INSTALLATION_PATH}/docker-compose.yml"
DEFAULT_OMERO_DATABASE_PATH="${OMERO_INSTALLATION_PATH%/}/omero_data/database"
DEFAULT_OMERO_PLUGIN_DATABASE_PATH="${OMERO_INSTALLATION_PATH%/}/omero_data/plugin_database"
OMERO_DATABASE_PATH="${OMERO_INSTALLATION_PATH%/}/omero_data/database"
OMERO_PLUGIN_DATABASE_PATH="${OMERO_INSTALLATION_PATH%/}/omero_data/plugin_database"
USE_CACHE_BUILD="${USE_CACHE_BUILD:-1}" # set to 1 to enable cached builds
KEEP_IMAGES="${KEEP_IMAGES:-0}"         # set to 1 to keep existing images

set -euo pipefail

# Bash requirement (warning)
# --------------------------
if [ -z "${BASH_VERSION:-}" ]; then
    echo "ERROR: This script MUST be run with bash. Run: sudo bash ./github_pull_project" >&2
    exit 1
fi

# Root-only safety check
# ----------------------
if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: This script must be run as root." >&2
    exit 1
fi

# Lockfile (prevents concurrent runs)
# -----------------------------------
LOCKFILE="/var/lock/${SCRIPT_NAME}.lock"

exec 9>"${LOCKFILE}"
if ! flock -w 15 9; then
    echo "ERROR: Could not acquire lock (${LOCKFILE}) within 15 seconds. Another update may be running." >&2
    exit 1
fi

is_valid_linux_path() {
    local path_input="$1"

    # Require an absolute Linux path and reject control characters.
    if [ -z "${path_input}" ] || [ "${path_input#/}" = "${path_input}" ]; then
        return 1
    fi

    if printf '%s' "${path_input}" | grep -q '[[:cntrl:]]'; then
        return 1
    fi

    return 0
}

validate_installation_path() {
    local install_path="$1"
    local parent_dir=""

    if ! is_valid_linux_path "${install_path}"; then
        return 1
    fi

    if [ -e "${install_path}" ] && [ ! -d "${install_path}" ]; then
        echo "Path exists but is not a directory: ${install_path}" >&2
        return 1
    fi

    if [ -d "${install_path}" ] && [ ! -w "${install_path}" ]; then
        echo "Directory is not writable: ${install_path}" >&2
        return 1
    fi

    if [ -d "${install_path}" ]; then
        return 0
    fi

    parent_dir="$(dirname "${install_path}")"
    if [ ! -d "${parent_dir}" ]; then
        echo "Parent directory does not exist: ${parent_dir}" >&2
        return 1
    fi

    if [ ! -w "${parent_dir}" ]; then
        echo "Parent directory is not writable: ${parent_dir}" >&2
        return 1
    fi

    return 0
}

ensure_installation_path() {
    local install_path="$1"

    if [ ! -d "${install_path}" ]; then
        echo "OMERO installation path does not exist. Creating with mode 0755: ${install_path}"
        if ! install -d -m 0755 "${install_path}"; then
            echo "ERROR: Failed to create OMERO installation path: ${install_path}" >&2
            return 1
        fi
    fi

    if [ ! -w "${install_path}" ]; then
        echo "ERROR: OMERO installation path is not writable: ${install_path}" >&2
        return 1
    fi

    return 0
}

ensure_data_path() {
    local data_path="$1"
    local path_label="$2"

    if [ -e "${data_path}" ] && [ ! -d "${data_path}" ]; then
        echo "ERROR: ${path_label} exists but is not a directory: ${data_path}" >&2
        return 1
    fi

    if [ ! -d "${data_path}" ]; then
        echo "${path_label} does not exist. Creating with mode 0755: ${data_path}"
        if ! install -d -m 0755 "${data_path}"; then
            echo "ERROR: Failed to create ${path_label}: ${data_path}" >&2
            return 1
        fi
    fi

    if [ ! -w "${data_path}" ]; then
        echo "ERROR: ${path_label} is not writable: ${data_path}" >&2
        return 1
    fi

    return 0
}

persist_compose_path_overrides() {
    local env_file_path="${OMERO_INSTALLATION_PATH%/}/.env"

    touch "${env_file_path}"

    if grep -q '^OMERO_DATABASE_PATH=' "${env_file_path}"; then
        sed -i "s|^OMERO_DATABASE_PATH=.*|OMERO_DATABASE_PATH=${OMERO_DATABASE_PATH}|" "${env_file_path}"
    else
        printf '\nOMERO_DATABASE_PATH=%s\n' "${OMERO_DATABASE_PATH}" >> "${env_file_path}"
    fi

    if grep -q '^OMERO_PLUGIN_DATABASE_PATH=' "${env_file_path}"; then
        sed -i "s|^OMERO_PLUGIN_DATABASE_PATH=.*|OMERO_PLUGIN_DATABASE_PATH=${OMERO_PLUGIN_DATABASE_PATH}|" "${env_file_path}"
    else
        printf 'OMERO_PLUGIN_DATABASE_PATH=%s\n' "${OMERO_PLUGIN_DATABASE_PATH}" >> "${env_file_path}"
    fi
}

echo "Do you want to delete all container images? Y/n (Default: n)"

while true; do
    read -r -p "> " DELETE_IMAGES_REPLY
    DELETE_IMAGES_REPLY="$(printf '%s' "${DELETE_IMAGES_REPLY}" | tr '[:upper:]' '[:lower:]')"

    if [ -z "${DELETE_IMAGES_REPLY}" ] || [ "${DELETE_IMAGES_REPLY}" = "n" ] || [ "${DELETE_IMAGES_REPLY}" = "no" ]; then
        KEEP_IMAGES=1
        break
    elif [ "${DELETE_IMAGES_REPLY}" = "y" ] || [ "${DELETE_IMAGES_REPLY}" = "yes" ]; then
        KEEP_IMAGES=0
        break
    else
        echo "Wrong choice. Please type Y or n."
    fi
done

echo "Do you want to use the default OMERO installation path (${DEFAULT_OMERO_INSTALLATION_PATH})? Y/n (Default: n)"
while true; do
    read -r -p "> " USE_DEFAULT_OMERO_INSTALLATION_PATH_REPLY
    USE_DEFAULT_OMERO_INSTALLATION_PATH_REPLY="$(printf '%s' "${USE_DEFAULT_OMERO_INSTALLATION_PATH_REPLY}" | tr '[:upper:]' '[:lower:]')"

    if [ -z "${USE_DEFAULT_OMERO_INSTALLATION_PATH_REPLY}" ] || [ "${USE_DEFAULT_OMERO_INSTALLATION_PATH_REPLY}" = "n" ] || [ "${USE_DEFAULT_OMERO_INSTALLATION_PATH_REPLY}" = "no" ]; then
        while true; do
            read -r -p "OMERO installation path: (Default: ${DEFAULT_OMERO_INSTALLATION_PATH}) " OMERO_INSTALLATION_PATH_REPLY

            if [ -z "${OMERO_INSTALLATION_PATH_REPLY}" ]; then
                OMERO_INSTALLATION_PATH_REPLY="${DEFAULT_OMERO_INSTALLATION_PATH}"
            fi

            if validate_installation_path "${OMERO_INSTALLATION_PATH_REPLY}" \
                && ensure_installation_path "${OMERO_INSTALLATION_PATH_REPLY}"; then
                OMERO_INSTALLATION_PATH="${OMERO_INSTALLATION_PATH_REPLY}"
                break
            fi

            echo "Wrong OMERO installation path, try again: (Default: ${DEFAULT_OMERO_INSTALLATION_PATH})"
        done

        DEFAULT_OMERO_DATABASE_PATH="${OMERO_INSTALLATION_PATH%/}/omero_data/database"
        DEFAULT_OMERO_PLUGIN_DATABASE_PATH="${OMERO_INSTALLATION_PATH%/}/omero_data/plugin_database"

        while true; do
            read -r -p "OMERO database installation path: (Default: ${DEFAULT_OMERO_DATABASE_PATH}) " OMERO_DATABASE_PATH_REPLY

            if [ -z "${OMERO_DATABASE_PATH_REPLY}" ]; then
                OMERO_DATABASE_PATH_REPLY="${DEFAULT_OMERO_DATABASE_PATH}"
            fi

            if validate_installation_path "${OMERO_DATABASE_PATH_REPLY}" \
                && ensure_data_path "${OMERO_DATABASE_PATH_REPLY}" "OMERO database directory"; then
                OMERO_DATABASE_PATH="${OMERO_DATABASE_PATH_REPLY}"
                break
            fi

            echo "Wrong OMERO database installation path, try again: (Default: ${DEFAULT_OMERO_DATABASE_PATH})"
        done

        while true; do
            read -r -p "OMERO plugin database installation path: (Default: ${DEFAULT_OMERO_PLUGIN_DATABASE_PATH}) " OMERO_PLUGIN_DATABASE_PATH_REPLY

            if [ -z "${OMERO_PLUGIN_DATABASE_PATH_REPLY}" ]; then
                OMERO_PLUGIN_DATABASE_PATH_REPLY="${DEFAULT_OMERO_PLUGIN_DATABASE_PATH}"
            fi

            if validate_installation_path "${OMERO_PLUGIN_DATABASE_PATH_REPLY}" \
                && ensure_data_path "${OMERO_PLUGIN_DATABASE_PATH_REPLY}" "OMP plugin database directory"; then
                OMERO_PLUGIN_DATABASE_PATH="${OMERO_PLUGIN_DATABASE_PATH_REPLY}"
                break
            fi

            echo "Wrong OMERO plugin database installation path, try again: (Default: ${DEFAULT_OMERO_PLUGIN_DATABASE_PATH})"
        done
        break
    elif [ "${USE_DEFAULT_OMERO_INSTALLATION_PATH_REPLY}" = "y" ] || [ "${USE_DEFAULT_OMERO_INSTALLATION_PATH_REPLY}" = "yes" ]; then
        if validate_installation_path "${DEFAULT_OMERO_INSTALLATION_PATH}" \
            && ensure_installation_path "${DEFAULT_OMERO_INSTALLATION_PATH}"; then
            OMERO_INSTALLATION_PATH="${DEFAULT_OMERO_INSTALLATION_PATH}"
            break
        fi

        echo "Wrong OMERO installation path, try again: (Default: ${DEFAULT_OMERO_INSTALLATION_PATH})"
    else
        echo "Wrong choice. Please type Y or n."
    fi
done

if ! ensure_installation_path "${OMERO_INSTALLATION_PATH}"; then
    echo "ERROR: Unable to prepare OMERO installation path: ${OMERO_INSTALLATION_PATH}" >&2
    exit 1
fi

if ! ensure_data_path "${OMERO_DATABASE_PATH}" "OMERO database directory"; then
    exit 1
fi

if ! ensure_data_path "${OMERO_PLUGIN_DATABASE_PATH}" "OMP plugin database directory"; then
    exit 1
fi

persist_compose_path_overrides

COMPOSE_FILE="${OMERO_INSTALLATION_PATH}/docker-compose.yml"

# Workflow
# --------
cd "${OMERO_INSTALLATION_PATH}"
SCRIPT_BACKUP=""
if [ -f "${SCRIPT_NAME}" ]; then
    echo "Backing up script..."
    SCRIPT_BACKUP="/tmp/${SCRIPT_NAME}.backup.$(date +%s)"
    cp "${SCRIPT_NAME}" "${SCRIPT_BACKUP}"
fi

echo "Pulling latest docker-compose.yml from GitHub..."
rm -rf temp_clone
git clone -b "${REPO_BRANCH}" "${REPO_URL}" temp_clone
if [ ! -d "temp_clone" ]; then
    echo "ERROR: Git clone failed"
    exit 1
fi
cp temp_clone/docker-compose.yml docker-compose.yml.new

echo "Stopping containers with latest docker-compose.yml..."
if [ "${KEEP_IMAGES}" -eq 1 ]; then
    docker compose -f docker-compose.yml.new down --remove-orphans || docker compose down --remove-orphans || true
else
    docker compose -f docker-compose.yml.new down --remove-orphans --rmi all || docker compose down --remove-orphans --rmi all || true
    echo "Removing ALL images referenced by docker-compose.yml..."
    COMPOSE_IMAGES="$(docker compose -f docker-compose.yml.new config --images 2>/dev/null || true)"
    if [ -n "${COMPOSE_IMAGES}" ]; then
        echo "${COMPOSE_IMAGES}" | xargs -r docker rmi -f || true
    fi
fi

echo "Removing stale OMERO repository lock files from the OMERO volume..."

PROJECT_NAME="$(basename "${OMERO_INSTALLATION_PATH}")"
OMERO_VOLUME="${PROJECT_NAME}_omero"

if docker volume inspect "${OMERO_VOLUME}" >/dev/null 2>&1; then
    CLEANUP_IMAGE="alpine:3.20"
    docker run --rm \
        -v "${OMERO_VOLUME}:/OMERO" \
        "${CLEANUP_IMAGE}" \
        sh -lc 'find /OMERO -name "*.lock" -delete || true'
    docker image rm "${CLEANUP_IMAGE}" >/dev/null 2>&1 || true
else
    echo "WARNING: Volume ${OMERO_VOLUME} not found; skipping lock cleanup."
fi

# echo "Removing dangling images..."
# docker image prune -f # this is potentially DANGEROUS and should be avoided

echo "Removing all files except script..."
find . -mindepth 1 -maxdepth 1 ! -name "${SCRIPT_NAME}" ! -name "temp_clone" ! -name "docker-compose.yml.new" ! -name ".env" -exec rm -rf {} +

echo "Moving new files..."
echo "Fixing line endings in shell scripts..."
find temp_clone -name "*.sh" -type f -exec sed -i 's/\r$//' {} \;
shopt -s dotglob
mv temp_clone/* .
shopt -u dotglob
rm -rf temp_clone
rm -f docker-compose.yml.new

echo "Restoring script..."
if [ -n "${SCRIPT_BACKUP}" ] && [ -f "${SCRIPT_BACKUP}" ]; then
    mv "${SCRIPT_BACKUP}" "${SCRIPT_NAME}"
fi

if [ ! -f "${COMPOSE_FILE}" ]; then
    echo "ERROR: docker-compose.yml still missing after clone. Aborting." >&2
    exit 1
fi

if [ "${USE_CACHE_BUILD}" -eq 1 ]; then
    echo "Building all OMERO-related containers (cache enabled)..."
    docker compose -f "${COMPOSE_FILE}" build
else
    echo "Building all OMERO-related containers (no cache)..."
    docker compose -f "${COMPOSE_FILE}" build --no-cache
fi

echo "Starting containers..."
docker compose -f "${COMPOSE_FILE}" up -d

echo "Done. Wait 30 seconds and check if the containers are up and running."
