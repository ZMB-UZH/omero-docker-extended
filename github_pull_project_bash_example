#!/usr/bin/env bash

# Configuration
# -------------
SCRIPT_NAME="$(basename "$0")"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SCRIPT_ENV_FILE=""
INSTALLATION_ENV_FILE_OVERRIDE="${INSTALLATION_PATHS_ENV_FILE:-}"

REPO_URL="git@github.com:strmt7/omero-zmb-omp-plugin.git"
REPO_BRANCH="test"
USE_CACHE_BUILD="${USE_CACHE_BUILD:-1}" # set to 1 to enable cached builds
KEEP_IMAGES="${KEEP_IMAGES:-0}"         # set to 1 to keep existing images

set -euo pipefail

REFRESH_CLONE_DIR=""

cleanup_refresh_clone_dir() {
    if [ -n "${REFRESH_CLONE_DIR}" ] && [ -d "${REFRESH_CLONE_DIR}" ]; then
        rm -rf "${REFRESH_CLONE_DIR}"
    fi
}

pull_installation_env_file_first() {
    local refreshed_env_file="${SCRIPT_DIR}/env/installation_paths.env"

    REFRESH_CLONE_DIR="$(mktemp -d "${SCRIPT_DIR%/}/.installation-env-refresh.XXXXXX")"

    if [ ! -d "${REFRESH_CLONE_DIR}" ]; then
        echo "ERROR: Failed to create temporary directory for refreshing installation_paths.env." >&2
        return 1
    fi

    if ! git clone --depth 1 -b "${REPO_BRANCH}" "${REPO_URL}" "${REFRESH_CLONE_DIR}" >/dev/null 2>&1; then
        echo "ERROR: Failed to pull latest files from ${REPO_URL} (${REPO_BRANCH}). Unable to refresh installation_paths.env." >&2
        return 1
    fi

    if [ ! -f "${REFRESH_CLONE_DIR}/env/installation_paths.env" ]; then
        echo "ERROR: Pulled repository is missing env/installation_paths.env on branch ${REPO_BRANCH}." >&2
        return 1
    fi

    if ! install -d -m 0755 "$(dirname "${refreshed_env_file}")"; then
        echo "ERROR: Failed to create directory for refreshed installation_paths.env: ${refreshed_env_file}" >&2
        return 1
    fi

    if ! cp "${REFRESH_CLONE_DIR}/env/installation_paths.env" "${refreshed_env_file}"; then
        echo "ERROR: Failed to copy refreshed installation_paths.env to ${refreshed_env_file}." >&2
        return 1
    fi

    echo "Pulled latest installation_paths.env from ${REPO_URL} (${REPO_BRANCH}) to ${refreshed_env_file}."
    return 0
}

create_default_installation_env_file() {
    local target_env_file="$1"
    local default_installation_path="${SCRIPT_DIR}"
    local default_database_path="${default_installation_path%/}/database"
    local default_plugin_database_path="${default_installation_path%/}/plugin_database"

    if ! install -d -m 0755 "$(dirname "${target_env_file}")"; then
        echo "ERROR: Failed to create directory for default configuration file: ${target_env_file}" >&2
        return 1
    fi

    cat > "${target_env_file}" <<EOF
OMERO_INSTALLATION_PATH=${default_installation_path}
OMERO_DATABASE_PATH=${default_database_path}
OMERO_PLUGIN_DATABASE_PATH=${default_plugin_database_path}
EOF

    echo "WARNING: installation_paths.env was missing. Created defaults at ${target_env_file}" >&2
    echo "WARNING: Review and edit ${target_env_file} before running in production." >&2

    SCRIPT_ENV_FILE="${target_env_file}"
    return 0
}

resolve_script_env_file() {
    local -a candidate_files=()
    local candidate_file=""

    if [ -n "${INSTALLATION_ENV_FILE_OVERRIDE}" ]; then
        candidate_files+=("${INSTALLATION_ENV_FILE_OVERRIDE}")
    fi

    candidate_files+=(
        "${SCRIPT_DIR}/env/installation_paths.env"
        "${SCRIPT_DIR}/../env/installation_paths.env"
        "${PWD}/env/installation_paths.env"
    )

    for candidate_file in "${candidate_files[@]}"; do
        if [ -f "${candidate_file}"; then
            SCRIPT_ENV_FILE="${candidate_file}"
            return 0
        fi
    done

    if [ -n "${INSTALLATION_ENV_FILE_OVERRIDE}" ]; then
        echo "ERROR: INSTALLATION_PATHS_ENV_FILE was provided but does not exist: ${INSTALLATION_ENV_FILE_OVERRIDE}" >&2
        return 1
    fi

    create_default_installation_env_file "${SCRIPT_DIR}/env/installation_paths.env"
}

# Bash requirement (warning)
# --------------------------
if [ -z "${BASH_VERSION:-}" ]; then
    echo "ERROR: This script MUST be run with bash. Run: sudo bash ./github_pull_project" >&2
    exit 1
fi

trap cleanup_refresh_clone_dir EXIT

if ! pull_installation_env_file_first; then
    exit 1
fi

if ! resolve_script_env_file; then
    exit 1
fi

# shellcheck disable=SC1090
. "${SCRIPT_ENV_FILE}"

require_config_var() {
    local variable_name="$1"
    local variable_value="${!variable_name:-}"

    if [ -z "${variable_value}" ]; then
        echo "ERROR: Missing required configuration variable ${variable_name} in ${SCRIPT_ENV_FILE}" >&2
        return 1
    fi

    if ! is_valid_linux_path "${variable_value}"; then
        echo "ERROR: ${variable_name} must be a valid absolute Linux path: ${variable_value}" >&2
        return 1
    fi

    return 0
}

# Root-only safety check
# ----------------------
if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: This script must be run as root." >&2
    exit 1
fi

# Lockfile (prevents concurrent runs)
# -----------------------------------
LOCKFILE="/var/lock/${SCRIPT_NAME}.lock"

exec 9>"${LOCKFILE}"
if ! flock -w 15 9; then
    echo "ERROR: Could not acquire lock (${LOCKFILE}) within 15 seconds. Another update may be running." >&2
    exit 1
fi

is_valid_linux_path() {
    local path_input="$1"

    # Require an absolute Linux path and reject control characters.
    if [ -z "${path_input}" ] || [ "${path_input#/}" = "${path_input}" ]; then
        return 1
    fi

    if printf '%s' "${path_input}" | grep -q '[[:cntrl:]]'; then
        return 1
    fi

    return 0
}

validate_installation_path() {
    local install_path="$1"

    if ! is_valid_linux_path "${install_path}"; then
        return 1
    fi

    if [ -e "${install_path}" ] && [ ! -d "${install_path}" ]; then
        echo "Path exists but is not a directory: ${install_path}" >&2
        return 1
    fi

    if [ -d "${install_path}" ] && [ ! -w "${install_path}" ]; then
        echo "Directory is not writable: ${install_path}" >&2
        return 1
    fi

    return 0
}

ensure_installation_path() {
    local install_path="$1"

    if [ ! -d "${install_path}" ]; then
        echo "OMERO installation path does not exist. Creating with mode 0755: ${install_path}"
        if ! install -d -m 0755 "${install_path}"; then
            echo "ERROR: Failed to create OMERO installation path: ${install_path}" >&2
            return 1
        fi
    fi

    if [ ! -w "${install_path}" ]; then
        echo "ERROR: OMERO installation path is not writable: ${install_path}" >&2
        return 1
    fi

    return 0
}

ensure_data_path() {
    local data_path="$1"
    local path_label="$2"

    if [ -e "${data_path}" ] && [ ! -d "${data_path}" ]; then
        echo "ERROR: ${path_label} exists but is not a directory: ${data_path}" >&2
        return 1
    fi

    if [ ! -d "${data_path}" ]; then
        echo "${path_label} does not exist. Creating with mode 0755: ${data_path}"
        if ! install -d -m 0755 "${data_path}"; then
            echo "ERROR: Failed to create ${path_label}: ${data_path}" >&2
            return 1
        fi
    fi

    if [ ! -w "${data_path}" ]; then
        echo "ERROR: ${path_label} is not writable: ${data_path}" >&2
        return 1
    fi

    return 0
}

persist_compose_path_overrides() {
    local env_file_path="${OMERO_INSTALLATION_PATH%/}/.env"

    touch "${env_file_path}"

    if grep -q '^OMERO_DATABASE_PATH=' "${env_file_path}"; then
        sed -i "s|^OMERO_DATABASE_PATH=.*|OMERO_DATABASE_PATH=${OMERO_DATABASE_PATH}|" "${env_file_path}"
    else
        printf '\nOMERO_DATABASE_PATH=%s\n' "${OMERO_DATABASE_PATH}" >> "${env_file_path}"
    fi

    if grep -q '^OMERO_PLUGIN_DATABASE_PATH=' "${env_file_path}"; then
        sed -i "s|^OMERO_PLUGIN_DATABASE_PATH=.*|OMERO_PLUGIN_DATABASE_PATH=${OMERO_PLUGIN_DATABASE_PATH}|" "${env_file_path}"
    else
        printf 'OMERO_PLUGIN_DATABASE_PATH=%s\n' "${OMERO_PLUGIN_DATABASE_PATH}" >> "${env_file_path}"
    fi
}

copy_repo_files() {
    local clone_path="$1"
    local target_path="$2"

    find "${clone_path}" -mindepth 1 -maxdepth 1 ! -name "XTOmeroConnector.py" -exec mv {} "${target_path}" \;
}

echo "Do you want to delete all container images? Y/n (Default: n)"

while true; do
    read -r -p "> " DELETE_IMAGES_REPLY
    DELETE_IMAGES_REPLY="$(printf '%s' "${DELETE_IMAGES_REPLY}" | tr '[:upper:]' '[:lower:]')"

    if [ -z "${DELETE_IMAGES_REPLY}" ] || [ "${DELETE_IMAGES_REPLY}" = "n" ] || [ "${DELETE_IMAGES_REPLY}" = "no" ]; then
        KEEP_IMAGES=1
        break
    elif [ "${DELETE_IMAGES_REPLY}" = "y" ] || [ "${DELETE_IMAGES_REPLY}" = "yes" ]; then
        KEEP_IMAGES=0
        break
    else
        echo "Wrong choice. Please type Y or n."
    fi
done

require_config_var "OMERO_INSTALLATION_PATH"
require_config_var "OMERO_DATABASE_PATH"
require_config_var "OMERO_PLUGIN_DATABASE_PATH"

if ! validate_installation_path "${OMERO_INSTALLATION_PATH}"; then
    echo "ERROR: Invalid OMERO_INSTALLATION_PATH from ${SCRIPT_ENV_FILE}: ${OMERO_INSTALLATION_PATH}" >&2
    exit 1
fi

if ! validate_installation_path "${OMERO_DATABASE_PATH}"; then
    echo "ERROR: Invalid OMERO_DATABASE_PATH from ${SCRIPT_ENV_FILE}: ${OMERO_DATABASE_PATH}" >&2
    exit 1
fi

if ! validate_installation_path "${OMERO_PLUGIN_DATABASE_PATH}"; then
    echo "ERROR: Invalid OMERO_PLUGIN_DATABASE_PATH from ${SCRIPT_ENV_FILE}: ${OMERO_PLUGIN_DATABASE_PATH}" >&2
    exit 1
fi

echo "Using installation paths from ${SCRIPT_ENV_FILE}"
echo "OMERO_INSTALLATION_PATH=${OMERO_INSTALLATION_PATH}"
echo "OMERO_DATABASE_PATH=${OMERO_DATABASE_PATH}"
echo "OMERO_PLUGIN_DATABASE_PATH=${OMERO_PLUGIN_DATABASE_PATH}"

if ! ensure_installation_path "${OMERO_INSTALLATION_PATH}"; then
    echo "ERROR: Unable to prepare OMERO installation path: ${OMERO_INSTALLATION_PATH}" >&2
    exit 1
fi

if ! ensure_data_path "${OMERO_DATABASE_PATH}" "OMERO database directory"; then
    exit 1
fi

if ! ensure_data_path "${OMERO_PLUGIN_DATABASE_PATH}" "OMP plugin database directory"; then
    exit 1
fi

persist_compose_path_overrides

COMPOSE_FILE="${OMERO_INSTALLATION_PATH}/docker-compose.yml"

# Workflow
# --------
cd "${OMERO_INSTALLATION_PATH}"

echo "Pulling latest docker-compose.yml from GitHub..."
rm -rf temp_clone
git clone -b "${REPO_BRANCH}" "${REPO_URL}" temp_clone
if [ ! -d "temp_clone" ]; then
    echo "ERROR: Git clone failed"
    exit 1
fi
cp temp_clone/docker-compose.yml docker-compose.yml.new

echo "Stopping containers with latest docker-compose.yml..."
if [ "${KEEP_IMAGES}" -eq 1 ]; then
    docker compose -f docker-compose.yml.new down --remove-orphans || docker compose down --remove-orphans || true
else
    docker compose -f docker-compose.yml.new down --remove-orphans --rmi all || docker compose down --remove-orphans --rmi all || true
    echo "Removing ALL images referenced by docker-compose.yml..."
    COMPOSE_IMAGES="$(docker compose -f docker-compose.yml.new config --images 2>/dev/null || true)"
    if [ -n "${COMPOSE_IMAGES}" ]; then
        echo "${COMPOSE_IMAGES}" | xargs -r docker rmi -f || true
    fi
fi

echo "Removing stale OMERO repository lock files from the OMERO volume..."

PROJECT_NAME="$(basename "${OMERO_INSTALLATION_PATH}")"
OMERO_VOLUME="${PROJECT_NAME}_omero"

if docker volume inspect "${OMERO_VOLUME}" >/dev/null 2>&1; then
    CLEANUP_IMAGE="alpine:3.20"
    docker run --rm \
        -v "${OMERO_VOLUME}:/OMERO" \
        "${CLEANUP_IMAGE}" \
        sh -lc 'find /OMERO -name "*.lock" -delete || true'
    docker image rm "${CLEANUP_IMAGE}" >/dev/null 2>&1 || true
else
    echo "WARNING: Volume ${OMERO_VOLUME} not found; skipping lock cleanup."
fi

# echo "Removing dangling images..."
# docker image prune -f # this is potentially DANGEROUS and should be avoided

echo "Removing all files except script..."
find . -mindepth 1 -maxdepth 1 \
    ! -name "${SCRIPT_NAME}" \
    ! -name "temp_clone" \
    ! -name "docker-compose.yml.new" \
    ! -name ".env" \
    -exec rm -rf {} +

echo "Moving new files..."
echo "Fixing line endings in shell scripts..."
find temp_clone -name "*.sh" -type f -exec sed -i 's/\r$//' {} \;
copy_repo_files "temp_clone" "."
rm -rf temp_clone
rm -f docker-compose.yml.new

if [ ! -f "${COMPOSE_FILE}" ]; then
    echo "ERROR: docker-compose.yml still missing after clone. Aborting." >&2
    exit 1
fi

if [ "${USE_CACHE_BUILD}" -eq 1 ]; then
    echo "Building all OMERO-related containers (cache enabled)..."
    docker compose -f "${COMPOSE_FILE}" build
else
    echo "Building all OMERO-related containers (no cache)..."
    docker compose -f "${COMPOSE_FILE}" build --no-cache
fi

echo "Starting containers..."
docker compose -f "${COMPOSE_FILE}" up -d

echo "Done. Wait 30 seconds and check if the containers are up and running."
