discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "docker_containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.+)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_id"]
    regex         = "(.+)"
    target_label  = "container_id"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "(.+)"
    target_label  = "compose_service"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker_containers.output
  labels     = {}
  forward_to = [loki.write.local.receiver]
}

loki.source.file "omeroserver_internal_logs" {
  targets = [
    {
      __path__        = "/var/log/omero-server/*.log",
      compose_service = "omeroserver_internal",
      container       = "omeroserver-internal",
    },
    {
      __path__        = "/var/log/omero-server/*.out",
      compose_service = "omeroserver_internal",
      container       = "omeroserver-internal",
    },
    {
      __path__        = "/var/log/omero-server/*.err",
      compose_service = "omeroserver_internal",
      container       = "omeroserver-internal",
    },
    {
      __path__        = "/var/log/omero-server/*/*.log",
      compose_service = "omeroserver_internal",
      container       = "omeroserver-internal",
    },
    {
      __path__        = "/var/log/omero-server/*/*.out",
      compose_service = "omeroserver_internal",
      container       = "omeroserver-internal",
    },
    {
      __path__        = "/var/log/omero-server/*/*.err",
      compose_service = "omeroserver_internal",
      container       = "omeroserver-internal",
    },
  ]
  forward_to = [loki.write.local.receiver]
}

loki.source.file "omeroweb_internal_logs" {
  targets = [
    {
      __path__        = "/var/log/omero-web/*.log",
      compose_service = "omeroweb_internal",
      container       = "omeroweb-internal",
    },
    {
      __path__        = "/var/log/omero-web/*.out",
      compose_service = "omeroweb_internal",
      container       = "omeroweb-internal",
    },
    {
      __path__        = "/var/log/omero-web/*.err",
      compose_service = "omeroweb_internal",
      container       = "omeroweb-internal",
    },
    {
      __path__        = "/var/log/omero-web/*/*.log",
      compose_service = "omeroweb_internal",
      container       = "omeroweb-internal",
    },
    {
      __path__        = "/var/log/omero-web/*/*.out",
      compose_service = "omeroweb_internal",
      container       = "omeroweb-internal",
    },
    {
      __path__        = "/var/log/omero-web/*/*.err",
      compose_service = "omeroweb_internal",
      container       = "omeroweb-internal",
    },
    {
      __path__        = "/var/log/omero-web-supervisor/*.log",
      compose_service = "omeroweb_internal",
      container       = "omeroweb-internal",
    },
    {
      __path__        = "/var/log/omero-web-supervisor/*.out",
      compose_service = "omeroweb_internal",
      container       = "omeroweb-internal",
    },
    {
      __path__        = "/var/log/omero-web-supervisor/*.err",
      compose_service = "omeroweb_internal",
      container       = "omeroweb-internal",
    },
  ]
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
