# Coverage.py configuration for omero-docker-extended
#
# Each test suite is executed as a separate ``coverage run`` invocation
# (required because the root conftest.py installs mock stubs that
# interfere across test modules). The individual data files are merged
# with ``coverage combine`` before reporting.

[run]
# Use directory paths (with ./ prefix) so coverage.py resolves them as
# filesystem paths without attempting to import the packages - the
# conftest mocks are not yet loaded at tracer-start time.
source =
    ./omero_plugin_common
    ./omeroweb_omp_plugin
    ./omeroweb_import
    ./omeroweb_admin_tools
    ./omero_imaris_connector
    ./omeroweb_tools
    ./omero_web_zarr
omit =
    */tests/*
    omero_imaris_connector/XTOmeroConnector.py
    conftest.py

[report]
skip_empty = true
show_missing = true
# Suppress empty package-marker modules from report noise while still
# measuring executable package wiring modules that contain code.
omit =
    omero_plugin_common/__init__.py
    omero_plugin_common/apps.py
    omero_web_zarr/templatetags/__init__.py
    omeroweb_admin_tools/__init__.py
    omeroweb_admin_tools/services/__init__.py
    omeroweb_import/__init__.py
    omeroweb_import/services/__init__.py
    omeroweb_import/services/import_management/__init__.py
    omeroweb_import/services/jobs/__init__.py
    omeroweb_import/services/omero/__init__.py
    omeroweb_import/utils/__init__.py
    omeroweb_import/views/__init__.py
    omeroweb_omp_plugin/services/jobs/__init__.py
    omeroweb_omp_plugin/services/omero/__init__.py
    omeroweb_omp_plugin/services/parsing/__init__.py
    omeroweb_omp_plugin/utils/__init__.py
    omeroweb_tools/__init__.py
    omeroweb_tools/services/__init__.py
    omeroweb_tools/views/__init__.py

[xml]
output = coverage.xml
