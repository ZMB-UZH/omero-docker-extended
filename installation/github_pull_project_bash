#!/usr/bin/env bash
# shellcheck shell=bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
REPO_URL="${REPO_URL:-https://github.com/ZMB-UZH/omero-docker-extended.git}"
REPO_BRANCH="${REPO_BRANCH:-}"
STANDARD_INSTALLATION_SCRIPT_RELATIVE_PATH="installation/installation_script.sh"
INSTALLATION_SCRIPT_RELATIVE_PATH="${INSTALLATION_SCRIPT_RELATIVE_PATH:-${STANDARD_INSTALLATION_SCRIPT_RELATIVE_PATH}}"
INSTALLATION_PATHS_ENV_RELATIVE_PATH="${INSTALLATION_PATHS_ENV_RELATIVE_PATH:-installation_paths.env}"
INSTALLATION_AUTOMATION_MODE="${INSTALLATION_AUTOMATION_MODE:-0}"
REPO_SOURCE_REF="${REPO_SOURCE_REF:-}"
SELECTED_REPO_SOURCE_MODE="latest"
SELECTED_REPO_SOURCE_REF="latest"
TRANSCRIPT_HELPER_PATH="${SCRIPT_DIR}/install_transcript_utils.sh"

if [ -r "${TRANSCRIPT_HELPER_PATH}" ]; then
    # shellcheck disable=SC1090
    . "${TRANSCRIPT_HELPER_PATH}"
fi

if declare -F install_transcript_enable >/dev/null 2>&1; then
    install_transcript_enable "${REPO_ROOT_DIR}/${INSTALLATION_PATHS_ENV_RELATIVE_PATH}" "$0" "$@"
fi

# shellcheck disable=SC2034
BOOTSTRAP_CLONE_DIR=""

cleanup_bootstrap_clone_dir() {
    if [ -n "${BOOTSTRAP_CLONE_DIR}" ] && [ -d "${BOOTSTRAP_CLONE_DIR}" ]; then
        rm -rf "${BOOTSTRAP_CLONE_DIR}"
    fi
}


has_controlling_tty() {
    [ -r /dev/tty ] && [ -w /dev/tty ] && { : </dev/tty >/dev/tty; } 2>/dev/null
}


uses_standard_installation_script() {
    local normalized_path="${INSTALLATION_SCRIPT_RELATIVE_PATH#./}"

    [ "${normalized_path}" = "${STANDARD_INSTALLATION_SCRIPT_RELATIVE_PATH}" ]
}


is_hex_commit_selector() {
    local value="${1:-}"
    local length="${#value}"

    if [ "${length}" -lt 7 ] || [ "${length}" -gt 40 ]; then
        return 1
    fi

    case "${value}" in
        *[!0-9A-Fa-f]*) return 1 ;;
        *) return 0 ;;
    esac
}


is_valid_git_tag_selector() {
    local value="${1:-}"

    [ -n "${value}" ] || return 1
    git check-ref-format "refs/tags/${value}" >/dev/null 2>&1
}


remote_tag_exists() {
    local value="${1:-}"

    git ls-remote --exit-code --tags --refs \
        "${REPO_URL}" \
        "refs/tags/${value}" \
        >/dev/null 2>&1
}


resolve_latest_repo_branch() {
    local branch_ref=""
    local line=""
    local first_field=""
    local second_field=""

    if [ -n "${REPO_BRANCH}" ]; then
        return 0
    fi

    while IFS= read -r line; do
        first_field="${line%%[[:space:]]*}"
        second_field="${line#*[[:space:]]}"
        second_field="${second_field%%[[:space:]]*}"
        if [ "${first_field}" = "ref:" ]; then
            case "${second_field}" in
                refs/heads/*)
                    branch_ref="${second_field#refs/heads/}"
                    break
                    ;;
            esac
        fi
    done < <(git ls-remote --symref "${REPO_URL}" HEAD 2>/dev/null)

    if [ -z "${branch_ref}" ]; then
        echo "ERROR: Could not resolve the default branch from the configured REPO_URL." >&2
        echo "INFO: Set REPO_BRANCH explicitly, or verify the repository is reachable." >&2
        return 1
    fi

    REPO_BRANCH="${branch_ref}"
}


classify_repo_source_ref() {
    local value="${1:-}"

    case "${value}" in
        ""|"latest")
            SELECTED_REPO_SOURCE_MODE="latest"
            SELECTED_REPO_SOURCE_REF="latest"
            return 0
            ;;
    esac

    if is_valid_git_tag_selector "${value}" && remote_tag_exists "${value}"; then
        SELECTED_REPO_SOURCE_MODE="tag"
        SELECTED_REPO_SOURCE_REF="${value}"
        return 0
    fi

    if is_hex_commit_selector "${value}"; then
        SELECTED_REPO_SOURCE_MODE="commit"
        SELECTED_REPO_SOURCE_REF="${value}"
        return 0
    fi

    if ! is_valid_git_tag_selector "${value}"; then
        echo "ERROR: Invalid source version. Enter latest, a commit hash, or an exact GitHub release tag." >&2
        return 1
    fi

    echo "ERROR: GitHub release tag not found in the configured repository: ${value}" >&2
    return 1
}


select_repo_source_ref() {
    local reply="${REPO_SOURCE_REF:-}"

    if ! uses_standard_installation_script; then
        case "${reply}" in
            ""|"latest")
                SELECTED_REPO_SOURCE_MODE="latest"
                SELECTED_REPO_SOURCE_REF="latest"
                return 0
                ;;
            *)
                echo "ERROR: REPO_SOURCE_REF is supported only by the standard installation script." >&2
                echo "ERROR: Easy installation selects the prebuilt docker image with PREBUILT_IMAGE_RELEASE instead." >&2
                return 1
                ;;
        esac
    fi

    if [ -z "${reply}" ]; then
        if [ "${INSTALLATION_AUTOMATION_MODE}" = "1" ] || ! has_controlling_tty; then
            reply="latest"
        else
            printf '%s\n' "Which OMERO Docker Extended source version should be installed?" >/dev/tty
            printf '%s\n' "Enter latest, a commit hash, or a GitHub release tag. (Default: latest)" >/dev/tty
            printf '%s' '> ' >/dev/tty
            if ! IFS= read -r reply </dev/tty; then
                echo "ERROR: Could not read source version selection." >&2
                return 1
            fi
            if [ -z "${reply}" ]; then
                reply="latest"
            fi
        fi
    fi

    if ! classify_repo_source_ref "${reply}"; then
        return 1
    fi

    if [ "${SELECTED_REPO_SOURCE_MODE}" = "latest" ]; then
        if ! resolve_latest_repo_branch; then
            return 1
        fi
    fi

    case "${SELECTED_REPO_SOURCE_MODE}" in
        latest)
            echo "Source version: latest commit from configured branch ${REPO_BRANCH}."
            ;;
        tag)
            echo "Source version: GitHub release tag ${SELECTED_REPO_SOURCE_REF}."
            ;;
        commit)
            echo "Source version: commit ${SELECTED_REPO_SOURCE_REF}."
            ;;
        *)
            echo "ERROR: Unsupported source selection mode: ${SELECTED_REPO_SOURCE_MODE}" >&2
            return 1
            ;;
    esac
}


clone_repository_snapshot() {
    BOOTSTRAP_CLONE_DIR="$(mktemp -d "${REPO_ROOT_DIR%/}/.project-pull.XXXXXX")"

    if [ ! -d "${BOOTSTRAP_CLONE_DIR}" ]; then
        echo "ERROR: Failed to create temporary clone directory." >&2
        return 1
    fi

    case "${SELECTED_REPO_SOURCE_MODE}" in
        latest)
            if ! git clone --depth 1 --branch "${REPO_BRANCH}" -- "${REPO_URL}" "${BOOTSTRAP_CLONE_DIR}"; then
                echo "ERROR: Failed to pull latest project files from the configured REPO_URL and REPO_BRANCH." >&2
                echo "INFO: Verify REPO_URL and REPO_BRANCH are correct and reachable." >&2
                return 1
            fi
            ;;
        tag)
            if ! git clone --depth 1 --branch "${SELECTED_REPO_SOURCE_REF}" -- "${REPO_URL}" "${BOOTSTRAP_CLONE_DIR}"; then
                echo "ERROR: Failed to pull GitHub release tag ${SELECTED_REPO_SOURCE_REF} from the configured REPO_URL." >&2
                return 1
            fi
            ;;
        commit)
            if ! git clone --no-checkout -- "${REPO_URL}" "${BOOTSTRAP_CLONE_DIR}"; then
                echo "ERROR: Failed to clone repository from the configured REPO_URL." >&2
                return 1
            fi
            if ! git -C "${BOOTSTRAP_CLONE_DIR}" checkout --detach "${SELECTED_REPO_SOURCE_REF}^{commit}"; then
                echo "ERROR: Commit hash not found in the configured repository: ${SELECTED_REPO_SOURCE_REF}" >&2
                return 1
            fi
            ;;
        *)
            echo "ERROR: Unsupported source selection mode: ${SELECTED_REPO_SOURCE_MODE}" >&2
            return 1
            ;;
    esac

    echo "Checked out repository commit: $(git -C "${BOOTSTRAP_CLONE_DIR}" rev-parse HEAD)"
}

# ---------------------------------------------------------------------------
# resolve_all_data_paths
#
# Sources installation_paths.env inside a subshell (so variable references
# like ${OMERO_DATA_PATH}/... resolve correctly) and prints every known
# data/installation path, one per line.
# ---------------------------------------------------------------------------
resolve_all_data_paths() {
    local env_file="$1"

    if [ ! -r "${env_file}" ]; then
        echo "ERROR: Required installation paths file is missing or unreadable: ${env_file}" >&2
        return 1
    fi

    (
        local env_line
        while IFS= read -r env_line || [ -n "${env_line}" ]; do
            case "${env_line}" in
                ''|'#'*)
                    continue
                    ;;
                [A-Za-z_]*=*)
                    eval "${env_line}"
                    ;;
                *)
                    ;;
            esac
        done < "${env_file}"

        printf '%s\n' \
            "${OMERO_INSTALLATION_PATH:-}" \
            "${OMERO_DATABASE_PATH:-}" \
            "${OMERO_PLUGIN_DATABASE_PATH:-}" \
            "${OMERO_DATA_PATH:-}" \
            "${OMERO_TMP_PATH:-}" \
            "${OMERO_USER_DATA_PATH:-}" \
            "${OMERO_IMPORT_PATH:-}" \
            "${OMERO_SERVER_VAR_PATH:-}" \
            "${OMERO_WEB_VAR_PATH:-}" \
            "${OMERO_SERVER_LOGS_PATH:-}" \
            "${OMERO_WEB_LOGS_PATH:-}" \
            "${OMERO_WEB_SUPERVISOR_LOGS_PATH:-}" \
            "${PORTAINER_DATA_PATH:-}" \
            "${PROMETHEUS_DATA_PATH:-}" \
            "${GRAFANA_DATA_PATH:-}" \
            "${LOKI_DATA_PATH:-}" \
            "${PG_MAINTENANCE_DATA_PATH:-}" \
            "${NODE_EXPORTER_TEXTFILE_PATH:-}" \
            "${CROWDSEC_DB_PATH:-}" \
            "${CROWDSEC_CONFIG_PATH:-}"
    )
}

# ---------------------------------------------------------------------------
# collect_protected_top_level_names
#
# Reads installation_paths.env, resolves every path variable and emits the
# unique set of first-level directory names that fall *under* the repository
# root.  These names are excluded from the rm -rf during file replacement.
# ---------------------------------------------------------------------------
collect_protected_top_level_names() {
    local repo_dir="${1%/}"
    local env_file="${repo_dir}/${INSTALLATION_PATHS_ENV_RELATIVE_PATH}"

    if [ ! -r "${env_file}" ]; then
        echo "ERROR: ${env_file} is missing or unreadable." >&2
        echo "ERROR: Refusing to continue because replacement without explicit protected paths can delete OMERO data/database directories." >&2
        return 1
    fi

    local resolved_paths
    resolved_paths="$(resolve_all_data_paths "${env_file}")"

    local _path _rel _top
    while IFS= read -r _path; do
        [ -z "${_path}" ] && continue
        _path="${_path%/}"
        [ "${_path}" = "${repo_dir}" ] && continue
        case "${_path}" in
            "${repo_dir}/"*)
                _rel="${_path#"${repo_dir}/"}"
                _top="${_rel%%/*}"
                [ -n "${_top}" ] && printf '%s\n' "${_top}"
                ;;
        esac
    done <<< "${resolved_paths}" | sort -u
}

# ---------------------------------------------------------------------------
# collect_sentinel_dir_names
#
# Extracts every unique directory-name component that is specific to the
# installation / data paths.  For each resolved path the portion relative to
# OMERO_INSTALLATION_PATH is split into components.
#
# Example: /opt/omero/postgresdb/omero_database  (root=/opt/omero/)
#          → sentinels: postgresdb, omero_database
#
# These sentinel names are used by the deep-scan safety net: before deleting
# any top-level candidate, we recursively check whether it (or any of its
# subdirectories at ANY depth) carries a sentinel name.  If it does, the
# entire candidate is kept intact — no matter where the match occurs.
# ---------------------------------------------------------------------------
collect_sentinel_dir_names() {
    local repo_dir="${1%/}"
    local env_file="${repo_dir}/${INSTALLATION_PATHS_ENV_RELATIVE_PATH}"

    if [ ! -r "${env_file}" ]; then
        echo "ERROR: ${env_file} is missing or unreadable." >&2
        return 1
    fi

    (
        # shellcheck disable=SC1090
        . "${env_file}" 2>/dev/null || exit 0

        local _install_root="${OMERO_INSTALLATION_PATH:-}"
        _install_root="${_install_root%/}"

        for _path in \
            "${OMERO_DATABASE_PATH:-}" \
            "${OMERO_PLUGIN_DATABASE_PATH:-}" \
            "${OMERO_DATA_PATH:-}" \
            "${OMERO_TMP_PATH:-}" \
            "${OMERO_USER_DATA_PATH:-}" \
            "${OMERO_IMPORT_PATH:-}" \
            "${OMERO_SERVER_VAR_PATH:-}" \
            "${OMERO_WEB_VAR_PATH:-}" \
            "${OMERO_SERVER_LOGS_PATH:-}" \
            "${OMERO_WEB_LOGS_PATH:-}" \
            "${OMERO_WEB_SUPERVISOR_LOGS_PATH:-}" \
            "${PORTAINER_DATA_PATH:-}" \
            "${PROMETHEUS_DATA_PATH:-}" \
            "${GRAFANA_DATA_PATH:-}" \
            "${LOKI_DATA_PATH:-}" \
            "${PG_MAINTENANCE_DATA_PATH:-}" \
            "${NODE_EXPORTER_TEXTFILE_PATH:-}" \
            "${CROWDSEC_DB_PATH:-}" \
            "${CROWDSEC_CONFIG_PATH:-}"; do

            [ -z "${_path}" ] && continue
            _path="${_path%/}"

            # Derive the portion relative to the installation root so we
            # only collect data-specific names, not generic system dirs.
            local _rel=""
            if [ -n "${_install_root}" ] && [ "${_path}" != "${_install_root}" ]; then
                case "${_path}" in
                    "${_install_root}/"*)
                        _rel="${_path#"${_install_root}/"}"
                        ;;
                    *)
                        _rel="$(basename "${_path}")"
                        ;;
                esac
            else
                _rel="$(basename "${_path}")"
            fi

            # Split the relative path on '/' without mutating shell word-splitting state.
            local _remaining_rel="${_rel}"
            local _component=""
            while [ -n "${_remaining_rel}" ]; do
                _component="${_remaining_rel%%/*}"
                [ -n "${_component}" ] && printf '%s\n' "${_component}"
                [ "${_remaining_rel}" = "${_component}" ] && break
                _remaining_rel="${_remaining_rel#*/}"
            done
        done
    ) | sort -u
}

replace_working_tree_with_clone() {
    local clone_dir="$1"
    local current_repo_dir="$2"
    local preserve_logo_png=false
    local -a active_protected_files=()

    if [ -f "${current_repo_dir}/logo/logo.png" ]; then
        preserve_logo_png=true
        active_protected_files+=("logo/logo.png")
    fi

    # ── 1. Collect top-level data directories (direct exclusions) ─────
    local -a protected_data_dirs=()
    local _name
    while IFS= read -r _name; do
        [ -n "${_name}" ] && protected_data_dirs+=("${_name}")
    done < <(collect_protected_top_level_names "${current_repo_dir}")

    if [ ${#protected_data_dirs[@]} -eq 0 ]; then
        echo "WARNING: No top-level protected data directories were discovered under ${current_repo_dir}." >&2
        echo "WARNING: Continuing with sentinel deep-scan protection only." >&2
    fi

    # ── 2. Collect sentinel directory names for the deep scan ─────────
    local -a sentinel_names=()
    while IFS= read -r _name; do
        [ -n "${_name}" ] && sentinel_names+=("${_name}")
    done < <(collect_sentinel_dir_names "${current_repo_dir}")

    if [ ${#sentinel_names[@]} -eq 0 ]; then
        echo "ERROR: No sentinel directory names were discovered from installation_paths.env." >&2
        echo "ERROR: Refusing to replace working tree because deep-scan protection cannot be applied." >&2
        return 1
    fi

    # ── 3. Build the find exclusion list ──────────────────────────────
    local -a find_args=()
    find_args+=( "${current_repo_dir}" -mindepth 1 -maxdepth 1 )

    # Built-in exclusions (always applied)
    find_args+=( ! -name '.git' )
    find_args+=( ! -name '.project-pull.*' )
    find_args+=( ! -name 'installation_paths.env' )
    find_args+=( ! -name '.env' )
    find_args+=( ! -name 'env' )

    # Data-path exclusions (derived from installation_paths.env)
    for _name in "${protected_data_dirs[@]}"; do
        find_args+=( ! -name "${_name}" )
    done

    # Exclude logo/ entirely when a site-local logo.png exists.
    if [ "${preserve_logo_png}" = true ]; then
        find_args+=( ! -name 'logo' )
    fi

    # ── 4. Deep-scan each remaining candidate for sentinel names ──────
    #
    # For every top-level entry that passed the exclusion filters above,
    # recursively check whether it (or ANY subdirectory at any depth)
    # carries a name that matches a known data / database directory.
    # If it does, the entry is kept intact as a safety measure.

    # Build a combined find-expression for all sentinel names:
    #   \( -name 'sentinel1' -o -name 'sentinel2' -o ... \)
    local -a sentinel_find_expr=()
    if [ ${#sentinel_names[@]} -gt 0 ]; then
        sentinel_find_expr+=( \( )
        local _first=true
        for _name in "${sentinel_names[@]}"; do
            if [ "${_first}" = true ]; then
                _first=false
            else
                sentinel_find_expr+=( -o )
            fi
            sentinel_find_expr+=( -name "${_name}" )
        done
        sentinel_find_expr+=( \) )
    fi

    local -a to_remove=()
    local -a kept_by_deep_scan=()
    local _candidate _candidate_name

    while IFS= read -r _candidate; do
        [ -z "${_candidate}" ] && continue
        _candidate_name="$(basename "${_candidate}")"

        # Deep scan: if the candidate is a directory and sentinel names
        # are available, look for ANY matching subdirectory at any depth.
        if [ -d "${_candidate}" ] && [ ${#sentinel_find_expr[@]} -gt 0 ]; then
            if find "${_candidate}" -type d "${sentinel_find_expr[@]}" -print -quit 2>/dev/null | grep -q .; then
                kept_by_deep_scan+=("${_candidate_name}")
                continue
            fi
        fi

        to_remove+=("${_candidate}")
    done < <(find "${find_args[@]}" 2>/dev/null)

    # ── 5. Safety summary ─────────────────────────────────────────────
    echo "Protected (will NOT be removed):"
    echo "  - .git"
    echo "  - installation_paths.env (local installation paths source of truth)"
    echo "  - .env (docker compose runtime paths)"
    echo "  - env/ (credential and service env files)"
    if [ ${#active_protected_files[@]} -gt 0 ]; then
        echo "  Preserved files (local file kept, sibling templates refreshed):"
        printf '    - %s\n' "${active_protected_files[@]}"
    fi
    echo "  - .project-pull.*"
    if [ ${#protected_data_dirs[@]} -gt 0 ]; then
        echo "  Top-level data directories (from installation_paths.env):"
        printf '    - %s\n' "${protected_data_dirs[@]}"
    fi
    if [ ${#kept_by_deep_scan[@]} -gt 0 ]; then
        echo "  Kept by deep scan (contain data/database subdirectories):"
        printf '    - %s\n' "${kept_by_deep_scan[@]}"
    fi
    if [ ${#sentinel_names[@]} -gt 0 ]; then
        echo "  Sentinel directory names used for deep scan:"
        printf '    - %s\n' "${sentinel_names[@]}"
    fi
    echo ""

    if [ ${#to_remove[@]} -eq 0 ]; then
        echo "No entries to replace."
    else
        echo "Entries that will be replaced with fresh repository files:"
        local _entry
        for _entry in "${to_remove[@]}"; do
            printf '  - %s\n' "$(basename "${_entry}")"
        done
    fi

    # ── 6. Perform the replacement ────────────────────────────────────
    for _candidate in "${to_remove[@]}"; do
        rm -rf "${_candidate}"
    done

    # Move fresh files from the clone into place, but skip .git,
    # installation_paths.env, and env/ so we never overwrite preserved
    # local configuration or credentials.
    # If logo.png exists locally, also skip wholesale replacement of logo/.
    local -a clone_move_find_args=()
    clone_move_find_args+=( "${clone_dir}" -mindepth 1 -maxdepth 1 )
    clone_move_find_args+=( ! -name '.git' )
    clone_move_find_args+=( ! -name 'installation_paths.env' )
    clone_move_find_args+=( ! -name 'env' )
    if [ "${preserve_logo_png}" = true ]; then
        clone_move_find_args+=( ! -name 'logo' )
    fi
    find "${clone_move_find_args[@]}" -exec mv {} "${current_repo_dir}" \;

    # Keep site-local logo/logo.png untouched while still refreshing
    # repository-managed template files inside logo/.
    if [ "${preserve_logo_png}" = true ] && [ -d "${clone_dir}/logo" ]; then
        mkdir -p "${current_repo_dir}/logo"
        if [ -f "${clone_dir}/logo/logo_example.png" ]; then
            cp "${clone_dir}/logo/logo_example.png" "${current_repo_dir}/logo/logo_example.png"
        fi
    fi

    # ── 7. Refresh *_example.env files inside the protected env/ dir ───
    #
    # The env/ directory is never deleted (user credentials + paths live
    # there), but the *_example.env templates must stay up-to-date with
    # the repository so users can compare them against their local copies.
    if [ -d "${clone_dir}/env" ]; then
        # Remove stale example files, then copy fresh ones from the clone.
        find "${current_repo_dir}/env" -maxdepth 1 -name '*_example.env' -delete 2>/dev/null || true
        find "${clone_dir}/env" -maxdepth 1 -name '*_example.env' \
            -exec cp {} "${current_repo_dir}/env/" \;
        echo "Refreshed *_example.env files in env/."
    fi

}

run_installation_script() {
    local installation_script_path="${REPO_ROOT_DIR}/${INSTALLATION_SCRIPT_RELATIVE_PATH}"

    if [ ! -f "${installation_script_path}" ]; then
        echo "ERROR: Installation script not found after pull: ${installation_script_path}" >&2
        return 1
    fi

    if ! chmod +x "${installation_script_path}"; then
        echo "ERROR: Failed to mark installation script executable: ${installation_script_path}" >&2
        return 1
    fi

    echo "Executing installation script: ${installation_script_path}"
    exec env \
        INSTALLATION_AUTOMATION_MODE="${INSTALLATION_AUTOMATION_MODE}" \
        USE_BUILDX_COMPRESSED_BUILD="${USE_BUILDX_COMPRESSED_BUILD:-1}" \
        DOCKER_BUILD_FLATTEN_FINAL_IMAGE="${DOCKER_BUILD_FLATTEN_FINAL_IMAGE:-0}" \
        bash "${installation_script_path}"
}

main() {
    if [ -z "${BASH_VERSION:-}" ]; then
        echo "ERROR: This script must be run with bash." >&2
        exit 1
    fi

    trap cleanup_bootstrap_clone_dir EXIT

    case "${REPO_URL}" in
        https://*|http://*)
            ;;
        *)
            echo "ERROR: installation/github_pull_project_bash supports only HTTP(S) repository URLs. Set REPO_URL to an https:// or http:// URL." >&2
            exit 1
            ;;
    esac

    if ! command -v git >/dev/null 2>&1; then
        echo "ERROR: git is required to pull repository source files." >&2
        exit 1
    fi

    local installation_paths_env_path="${REPO_ROOT_DIR%/}/${INSTALLATION_PATHS_ENV_RELATIVE_PATH}"
    if [ ! -r "${installation_paths_env_path}" ]; then
        echo "ERROR: Required file is missing or unreadable before update: ${installation_paths_env_path}" >&2
        echo "ERROR: This update script is intentionally refusing to run without installation_paths.env in the repository root to prevent accidental deletion of persistent OMERO paths." >&2
        exit 1
    fi

    select_repo_source_ref
    clone_repository_snapshot
    replace_working_tree_with_clone "${BOOTSTRAP_CLONE_DIR}" "${REPO_ROOT_DIR}"
    run_installation_script
}

main "$@"
