# Docker Compose environment file – loaded automatically by docker compose.
#
# This file contains fully-resolved default paths so that docker compose
# commands (up, down, ps, logs, ...) work out of the box without requiring
# --env-file or COMPOSE_ENV_FILES support (which needs Compose >= 2.24).
#
# The installation script (installation/installation_script.sh) overwrites
# this file with the actual resolved paths chosen during setup.  If you
# change paths in env/installation_paths.env, re-run the installation script
# so this file stays in sync.
#
# ---- paths (keep in sync with env/installation_paths.env) ----
OMERO_INSTALLATION_PATH=/opt/omero/
OMERO_DATABASE_PATH=/opt/omero/postgresdb/omero_database
OMERO_PLUGIN_DATABASE_PATH=/opt/omero/postgresdb/plugin_database
OMERO_DATA_PATH=/opt/omero/omero_data
OMERO_USER_DATA_PATH=/opt/omero/omero_data/omero_user_data
OMERO_UPLOAD_PATH=/opt/omero/omero_data/omero_upload
OMERO_SERVER_VAR_PATH=/opt/omero/omero_data/omero_server_var
OMERO_SERVER_LOGS_PATH=/opt/omero/omero_data/omero_server_logs
OMERO_WEB_LOGS_PATH=/opt/omero/omero_data/omero_web_logs
OMERO_WEB_SUPERVISOR_LOGS_PATH=/opt/omero/omero_data/omero_web_supervisor_logs
PORTAINER_DATA_PATH=/opt/omero/omero_data/portainer_data
PROMETHEUS_DATA_PATH=/opt/omero/omero_data/prometheus_data
GRAFANA_DATA_PATH=/opt/omero/omero_data/grafana_data
