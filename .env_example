# Options kept when the installer generates .env. The installer copies the
# other Compose settings from the deployment env files. Do not put secrets here.

# Redis persistence and memory
# Keep persistent storage and noeviction for web sessions and queued work.
REDIS_SAVE_POLICY=
REDIS_APPENDONLY=yes
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=noeviction

# Portainer HTTPS listener
# Set a host bind address, not a URL.
PORTAINER_HOST_BIND=0.0.0.0
