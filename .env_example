# Docker Compose interpolation values that are mirrored into generated .env.
#
# Compose resolves these before service-level env_file loading. The installer
# renders these tracked template assignments into generated .env while
# preserving deployment-local generated .env assignments that already exist.
REDIS_SAVE_POLICY=
REDIS_APPENDONLY=yes
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=noeviction
PORTAINER_HOST_BIND=0.0.0.0
