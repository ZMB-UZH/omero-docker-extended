#!/usr/bin/env bash
# Debian 13 (Trixie) extra packages installer — safe defaults for Docker CE hosts
# - Does NOT install Docker or container runtimes by default
# - Avoids common Docker CE conflicts (containerd/runc/docker.io/podman-docker)
# - Avoids time-daemon conflicts by default (does not install chrony/ntpsec)
# - Hard-stops on DNS/fetch errors to avoid partial installs
# - Writes a complete log file under /var/log/
#
# Run:
#   sudo bash ./debian_13_extra_packages_install_script
#
# Optional knobs:
#   DRY_RUN=1
#   INSTALL_RECOMMENDS=0
#   AVOID_DOCKER_CONFLICTS=1 (default)
#   INSTALL_CONTAINER_TOOLS=1  (opt-in)
#   INSTALL_NETWORK_STACK=1    (opt-in)
#   INSTALL_TIME_SYNC=1        (opt-in; installs chrony and may require disabling systemd-timesyncd)
#   ALLOW_TIME_DAEMON_SWITCH=1 (opt-in; allows disabling systemd-timesyncd if you insist on chrony)
#   RUN_AUTOREMOVE=1           (opt-in; default 0)

set -Eeuo pipefail
IFS=$'\n\t'

SCRIPT_NAME="$(basename "$0")"
LOCK_FILE="/var/lock/${SCRIPT_NAME}.lock"
LOG_PREFIX="[debian-13-extra-packages]"

DRY_RUN="${DRY_RUN:-0}"
ALLOW_NON_TRIXIE="${ALLOW_NON_TRIXIE:-0}"
INSTALL_RECOMMENDS="${INSTALL_RECOMMENDS:-1}"
INSTALL_PROPRIETARY_DRIVERS="${INSTALL_PROPRIETARY_DRIVERS:-1}"
BATCH_SIZE="${BATCH_SIZE:-40}"

# Safety toggles (defaults are conservative for servers that already run Docker CE)
# -----------------------------------------------------------------------------
AVOID_DOCKER_CONFLICTS="${AVOID_DOCKER_CONFLICTS:-1}"    # 1 = filter packages known to conflict with Docker CE
INSTALL_CONTAINER_TOOLS="${INSTALL_CONTAINER_TOOLS:-0}"  # 1 = allow installing podman/container tooling (default 0)
INSTALL_NETWORK_STACK="${INSTALL_NETWORK_STACK:-0}"      # 1 = allow installing network-manager/systemd-resolved (default 0)
INSTALL_TIME_SYNC="${INSTALL_TIME_SYNC:-0}"              # 1 = allow installing chrony (default 0; avoids time-daemon conflicts)
ALLOW_TIME_DAEMON_SWITCH="${ALLOW_TIME_DAEMON_SWITCH:-0}"# 1 = allow disabling timesyncd if installing chrony
RUN_AUTOREMOVE="${RUN_AUTOREMOVE:-0}"                    # 1 = run apt-get autoremove/autoclean at the end (default 0)

# APT robustness
APT_RETRIES="${APT_RETRIES:-3}"
APT_TIMEOUT="${APT_TIMEOUT:-30}"

# Logging
LOGFILE="${LOGFILE:-}"

log_info() {
    printf '%s INFO: %s\n' "${LOG_PREFIX}" "$*"
}

log_warn() {
    printf '%s WARN: %s\n' "${LOG_PREFIX}" "$*" >&2
}

log_error() {
    printf '%s ERROR: %s\n' "${LOG_PREFIX}" "$*" >&2
}

run_cmd() {
    if [ "${DRY_RUN}" = "1" ]; then
        printf 'DRY_RUN> %s\n' "$*"
        return 0
    fi

    "$@"
}

run_as_root() {
    if [ "$(id -u)" -eq 0 ]; then
        run_cmd "$@"
    else
        run_cmd sudo "$@"
    fi
}

setup_logging() {
    local ts
    ts="$(date +%F_%H%M%S)"

    if [ -z "${LOGFILE}" ]; then
        if [ "$(id -u)" -eq 0 ]; then
            LOGFILE="/var/log/debian-13-extra-packages_${ts}.log"
        else
            LOGFILE="${HOME}/debian-13-extra-packages_${ts}.log"
        fi
    fi

    run_as_root mkdir -p "$(dirname "${LOGFILE}")" 2>/dev/null || true

    # Redirect all output to both console and logfile.
    # shellcheck disable=SC2094
    exec > >(tee -a "${LOGFILE}") 2>&1
    log_info "Logging to: ${LOGFILE}"
}

require_binary() {
    local binary_name="$1"

    if ! command -v "${binary_name}" >/dev/null 2>&1; then
        log_error "Missing required command: ${binary_name}"
        exit 1
    fi
}

validate_positive_integer() {
    local value="$1"
    local label="$2"

    if ! [[ "${value}" =~ ^[0-9]+$ ]] || [ "${value}" -eq 0 ]; then
        log_error "${label} must be a positive integer. Received: ${value}"
        exit 1
    fi
}

acquire_lock() {
    if [ "${DRY_RUN}" = "1" ]; then
        log_info "Skipping lock acquisition in DRY_RUN mode."
        return 0
    fi

    run_as_root install -d -m 0755 /var/lock
    exec 9>"${LOCK_FILE}"

    if ! flock -w 30 9; then
        log_error "Could not acquire lock ${LOCK_FILE}; another apt transaction might be active."
        exit 1
    fi
}

validate_platform() {
    local os_id
    local version_id

    if [ ! -r /etc/os-release ]; then
        log_error "Cannot read /etc/os-release."
        exit 1
    fi

    # shellcheck disable=SC1091
    . /etc/os-release

    os_id="${ID:-}"
    version_id="${VERSION_ID:-}"

    if [ "${os_id}" != "debian" ]; then
        log_error "This script only supports Debian. Detected: ${os_id}"
        exit 1
    fi

    if [ "${version_id}" != "13" ] && [ "${ALLOW_NON_TRIXIE}" != "1" ]; then
        log_error "Detected Debian ${version_id}. Set ALLOW_NON_TRIXIE=1 to run outside Debian 13 (Trixie)."
        exit 1
    fi

    if [ "${version_id}" != "13" ] && [ "${ALLOW_NON_TRIXIE}" = "1" ]; then
        log_warn "Running outside Debian 13 because ALLOW_NON_TRIXIE=1 (detected VERSION_ID=${version_id})."
    fi
}

sanitize_pkg() {
    # Remove CRLF artifacts and trim leading/trailing whitespace
    local s="$1"
    s="${s//$'\r'/}"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    printf '%s' "${s}"
}

normalize_package_list() {
    sed 's/\r$//' | awk 'NF {print $1}' | sort -u
}

package_installed() {
    local package_name="$1"
    local pkg
    pkg="$(sanitize_pkg "${package_name}")"
    [ -z "${pkg}" ] && return 1

    dpkg-query -W -f='${Status}' "${pkg}" 2>/dev/null | grep -q 'install ok installed'
}

hardware_has_nvidia() {
    if ! command -v lspci >/dev/null 2>&1; then
        return 1
    fi

    lspci | grep -Eqi 'NVIDIA'
}

hardware_has_intel_gpu() {
    if ! command -v lspci >/dev/null 2>&1; then
        return 1
    fi

    lspci | grep -Eqi 'VGA|3D|Display' | grep -Eqi 'Intel'
}

hardware_has_amd_gpu() {
    if ! command -v lspci >/dev/null 2>&1; then
        return 1
    fi

    lspci | grep -Eqi 'VGA|3D|Display' | grep -Eqi 'AMD|ATI'
}

apt_get() {
    run_as_root env \
        DEBIAN_FRONTEND=noninteractive \
        APT_LISTCHANGES_FRONTEND=none \
        NEEDRESTART_MODE=a \
        apt-get \
            -o Acquire::Retries="${APT_RETRIES}" \
            -o Acquire::http::Timeout="${APT_TIMEOUT}" \
            -o Acquire::https::Timeout="${APT_TIMEOUT}" \
            -o Dpkg::Use-Pty=0 \
            "$@"
}

apt_get_simulate_install() {
    # Returns 0 only if apt believes the package is installable (and locatable) right now.
    # This is MUCH more reliable than apt-cache heuristics on Debian testing.
    local pkg="$1"
    local -a install_flags=()

    install_flags+=("-y")
    if [ "${INSTALL_RECOMMENDS}" = "0" ]; then
        install_flags+=("--no-install-recommends")
    fi

    # DRY_RUN: treat as installable to show intended actions, but still do not execute.
    if [ "${DRY_RUN}" = "1" ]; then
        return 0
    fi

    apt_get -s install "${install_flags[@]}" "${pkg}" >/dev/null 2>&1
}

ensure_dns_ok() {
    local host="${1:-deb.debian.org}"
    local i

    for i in {1..8}; do
        if getent hosts "${host}" >/dev/null 2>&1; then
            return 0
        fi
        sleep 2
    done

    log_error "DNS lookup failed for ${host}. Current /etc/resolv.conf:"
    run_cmd ls -l /etc/resolv.conf || true
    run_cmd cat /etc/resolv.conf || true
    return 1
}

protect_docker_packages() {
    # Mark Docker CE packages (if present) as manual to avoid autoremove surprises.
    local -a candidates=(
        docker-ce
        docker-ce-cli
        docker-buildx-plugin
        docker-compose-plugin
        docker-ce-rootless-extras
        containerd.io
    )

    local -a present=()
    local p

    for p in "${candidates[@]}"; do
        if dpkg-query -W -f='${Status}' "${p}" 2>/dev/null | grep -q "install ok installed"; then
            present+=("${p}")
        fi
    done

    if [ "${#present[@]}" -gt 0 ]; then
        log_info "Protecting Docker packages from autoremove: ${present[*]}"
        run_as_root apt-mark manual "${present[@]}" >/dev/null 2>&1 || true
    fi
}

mark_manual_installed() {
    local -a pkgs=("$@")

    if [ "${#pkgs[@]}" -eq 0 ]; then
        return 0
    fi

    log_info "Marking ${#pkgs[@]} packages as manually installed (apt-mark manual)."
    run_as_root apt-mark manual "${pkgs[@]}" >/dev/null 2>&1 || true
}

filter_package_catalog() {
    # Reads package names from stdin and filters out entries we do NOT want to install.
    local -a deny=()

    if [ "${AVOID_DOCKER_CONFLICTS}" = "1" ]; then
        # Avoid ANY docker/container runtime install from this script.
        # Docker CE uses containerd.io from Docker repo; installing Debian's containerd/runc/docker.io may conflict.
        deny+=(docker docker.io docker-ce docker-ce-cli docker-buildx-plugin docker-compose-plugin docker-ce-rootless-extras)
        deny+=(containerd containerd.io runc podman-docker)
    fi

    if [ "${INSTALL_CONTAINER_TOOLS}" != "1" ]; then
        deny+=(podman systemd-container)
    fi

    if [ "${INSTALL_NETWORK_STACK}" != "1" ]; then
        deny+=(network-manager network-manager-openvpn systemd-resolved)
    fi

    if [ "${INSTALL_TIME_SYNC}" != "1" ]; then
        # Avoid time-daemon conflicts by default.
        deny+=(chrony ntpsec ntp systemd-timesyncd)
    fi

    if [ "${#deny[@]}" -eq 0 ]; then
        cat
        return 0
    fi

    local regex
    regex="$(printf "%s|" "${deny[@]}")"
    regex="${regex%|}"

    awk -v re="^(${regex})$" '$0 !~ re { print }'
}

apt_update() {
    log_info "Refreshing apt metadata..."

    ensure_dns_ok "debian.ethz.ch" || ensure_dns_ok "security.debian.org" || ensure_dns_ok "download.docker.com"

    local out
    local rc

    set +e
    out="$(apt_get update 2>&1)"
    rc=$?
    set -e

    printf '%s\n' "${out}"

    if [ "${rc}" -ne 0 ]; then
        log_error "apt-get update failed (exit code ${rc})."
        return "${rc}"
    fi

    if printf '%s\n' "${out}" | grep -qiE 'Temporary failure resolving|Could not resolve|Failed to fetch|Some index files failed|Connection failed|Hash Sum mismatch'; then
        log_error "apt-get update reported fetch/DNS errors; refusing to continue."
        return 1
    fi
}

handle_time_sync_preflight() {
    # If the user explicitly asks for INSTALL_TIME_SYNC=1, we still refuse to cause dependency conflicts by default.
    # chrony conflicts with time-daemon providers; Debian often has systemd-timesyncd installed.
    if [ "${INSTALL_TIME_SYNC}" != "1" ]; then
        return 0
    fi

    if package_installed "systemd-timesyncd"; then
        if [ "${ALLOW_TIME_DAEMON_SWITCH}" = "1" ]; then
            log_warn "INSTALL_TIME_SYNC=1 and systemd-timesyncd is installed. ALLOW_TIME_DAEMON_SWITCH=1 => disabling timesyncd before chrony."
            run_as_root systemctl disable --now systemd-timesyncd.service >/dev/null 2>&1 || true
        else
            log_warn "INSTALL_TIME_SYNC=1 requested but systemd-timesyncd is installed."
            log_warn "To avoid time-daemon conflicts, chrony will be SKIPPED unless you set ALLOW_TIME_DAEMON_SWITCH=1."
        fi
    fi
}

install_packages_one_by_one() {
    local -a queue=("$@")
    local -a installed=()
    local -a skipped=()
    local total="${#queue[@]}"
    local n=0

    local -a install_flags=("-y")
    if [ "${INSTALL_RECOMMENDS}" = "0" ]; then
        install_flags+=("--no-install-recommends")
    fi

    for pkg in "${queue[@]}"; do
        n=$((n + 1))
        log_info "Installing package ${n}/${total}: ${pkg}"

        # Special-case chrony safety: even if it got into the queue, prevent known conflicts unless user allowed switching.
        if [ "${pkg}" = "chrony" ] && package_installed "systemd-timesyncd" && [ "${ALLOW_TIME_DAEMON_SWITCH}" != "1" ]; then
            log_warn "Skipping chrony to avoid time-daemon conflict (systemd-timesyncd installed; ALLOW_TIME_DAEMON_SWITCH!=1)."
            skipped+=("${pkg}")
            continue
        fi

        # Final guard: simulate right before install so we never emit "Unable to locate" or solver conflicts.
        if ! apt_get_simulate_install "${pkg}"; then
            log_warn "Skipping ${pkg} (not locatable or dependency conflict per apt simulation)."
            skipped+=("${pkg}")
            continue
        fi

        local out
        local rc

        set +e
        out="$(apt_get install "${install_flags[@]}" "${pkg}" 2>&1)"
        rc=$?
        set -e

        printf '%s\n' "${out}"

        if [ "${rc}" -ne 0 ]; then
            if printf '%s\n' "${out}" | grep -qiE 'Temporary failure resolving|Could not resolve|Failed to fetch'; then
                log_error "Network/DNS failure during apt-get install (package: ${pkg}); aborting early to avoid partial installs."
                return 2
            fi

            log_warn "Install failed for ${pkg}; marking as skipped to keep installer non-fatal."
            skipped+=("${pkg}")
            continue
        fi

        installed+=("${pkg}")
    done

    if [ "${#installed[@]}" -gt 0 ]; then
        log_info "Installed packages (${#installed[@]}):"
        printf '%s\n' "${installed[@]}" | sed 's/^/  - /'
    fi

    if [ "${#skipped[@]}" -gt 0 ]; then
        log_warn "Skipped packages (${#skipped[@]}):"
        printf '%s\n' "${skipped[@]}" | sed 's/^/  - /'
        log_warn "Skipped entries are normal on Debian testing (renames/removals/conflicts). Installer continues cleanly."
    fi

    return 0
}

