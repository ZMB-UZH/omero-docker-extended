main() {
    require_binary awk
    require_binary apt-cache
    require_binary dpkg-query
    require_binary flock
    require_binary grep
    require_binary sed
    require_binary sort
    require_binary tee
    require_binary getent

    validate_positive_integer "${BATCH_SIZE}" "BATCH_SIZE"
    validate_platform
    acquire_lock

    setup_logging
    protect_docker_packages

    apt_update
    handle_time_sync_preflight

    local package_catalog
    local -a already_installed=()
    local -a install_queue=()
    local -a skipped_by_availability=()

    package_catalog="$(build_package_catalog | normalize_package_list | filter_package_catalog)"

    while IFS= read -r raw_pkg; do
        local package_name
        package_name="$(sanitize_pkg "${raw_pkg}")"
        [ -z "${package_name}" ] && continue

        # Accept already-installed packages even if not currently in metadata.
        if package_installed "${package_name}"; then
            already_installed+=("${package_name}")
            continue
        fi

        # HARD RULE: only queue packages that APT simulation says are installable now.
        if apt_get_simulate_install "${package_name}"; then
            install_queue+=("${package_name}")
        else
            skipped_by_availability+=("${package_name}")
        fi
    done <<<"${package_catalog}"

    log_info "Catalog size: $(printf '%s\n' "${package_catalog}" | wc -l | awk '{print $1}') packages."
    log_info "Already installed: ${#already_installed[@]}"
    log_info "Pending install (installable now): ${#install_queue[@]}"

    if [ "${#skipped_by_availability[@]}" -gt 0 ]; then
        log_warn "Skipped (not locatable or dependency conflict per apt simulation) (${#skipped_by_availability[@]})."
        printf '%s\n' "${skipped_by_availability[@]}" | sed 's/^/  - /'
        log_warn "These are skipped safely to guarantee zero unmet-dependency errors."
    fi

    mark_manual_installed "${already_installed[@]}"

    if [ "${#install_queue[@]}" -eq 0 ]; then
        log_info "Nothing installable to add right now. System already satisfies the installable catalog."
        log_info "Done."
        return 0
    fi

    # Install one-by-one to avoid solver cascades on Debian testing.
    if install_packages_one_by_one "${install_queue[@]}"; then
        log_info "Package installation finished cleanly (with safe skips if needed)."
    else
        log_error "Installation aborted due to network/DNS failure (by design)."
        exit 2
    fi

    if [ "${RUN_AUTOREMOVE}" = "1" ]; then
        log_info "Running apt autoremove to clean stale dependencies (RUN_AUTOREMOVE=1)."
        apt_get autoremove -y
        log_info "Running apt autoclean."
        apt_get autoclean -y
    else
        log_info "Skipping apt autoremove/autoclean (RUN_AUTOREMOVE=0)."
    fi

    log_info "Done."
}

main "$@"
