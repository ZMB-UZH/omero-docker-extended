## ATTENTION!! Using the tag "latest" might be tempting but is extremely risky in production environments!
# Needs to match the respective one in docker-compose.yml
## ATTENTION!! The python venv lines will need to be changed to the correct/latest python venv and path
# when the Omero developers update the container

FROM openmicroscopy/omero-web-standalone:5

# Run as root to avoid permission issues with deletion
USER root

# Remove old copies of the plugin inside the container (if any)
RUN set -eux; \
    VENV_DIR="$(ls -d /opt/omero/web/venv* | head -n 1)"; \
    PY_VER="$("${VENV_DIR}/bin/python" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')"; \
    SITE_PACKAGES="${VENV_DIR}/lib/python${PY_VER}/site-packages"; \
    rm -rf "${SITE_PACKAGES}/omeroweb_omp_plugin"

# Copy the whole plugin into the container (temporary, then moved into site-packages)
COPY omeroweb_omp_plugin /tmp/omeroweb_omp_plugin

# Install psycopg2-binary
# Add redis and django-redis for shared cache across workers
# Fix permissions in the end (plugin should be owned by omero-web)
RUN set -eux; \
    VENV_DIR="$(ls -d /opt/omero/web/venv* | head -n 1)"; \
    PY_VER="$("${VENV_DIR}/bin/python" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')"; \
    SITE_PACKAGES="${VENV_DIR}/lib/python${PY_VER}/site-packages"; \
    cp -a /tmp/omeroweb_omp_plugin "${SITE_PACKAGES}/omeroweb_omp_plugin"; \
    "${VENV_DIR}/bin/pip" install --no-cache-dir \
        psycopg2-binary \
        redis>=5.0.0 \
        django-redis>=5.4.0; \
    chown -R omero-web:omero-web "${SITE_PACKAGES}/omeroweb_omp_plugin"; \
    rm -rf /tmp/omeroweb_omp_plugin

USER omero-web
