apt_update() {
    log_info "Refreshing apt metadata..."
    run_as_root env \
        DEBIAN_FRONTEND=noninteractive \
        APT_LISTBUGS_FRONTEND=none \
        APT_LISTCHANGES_FRONTEND=none \
        NEEDRESTART_MODE=a \
        apt-get -o Acquire::Retries=3 -o Dpkg::Use-Pty=0 update
}

install_packages_in_batches() {
    local -a queue=("$@")
    local -a failed=()
    local total="${#queue[@]}"
    local start=0
    local end=0
    local batch=()
    local install_flags=("-y" "-o" "Dpkg::Use-Pty=0" "-o" "Acquire::Retries=3" "-o" "Dpkg::Options::=--force-confdef" "-o" "Dpkg::Options::=--force-confold")

    if [ "${INSTALL_RECOMMENDS}" = "0" ]; then
        install_flags+=("--no-install-recommends")
    fi

    while [ "${start}" -lt "${total}" ]; do
        end=$((start + BATCH_SIZE))
        if [ "${end}" -gt "${total}" ]; then
            end="${total}"
        fi

        batch=("${queue[@]:start:end-start}")
        log_info "Installing package batch $((start + 1))-${end} of ${total}."

        if ! run_as_root env \
            DEBIAN_FRONTEND=noninteractive \
            APT_LISTBUGS_FRONTEND=none \
            APT_LISTCHANGES_FRONTEND=none \
            NEEDRESTART_MODE=a \
            apt-get install "${install_flags[@]}" "${batch[@]}"; then

            log_warn "Batch install failed. Retrying packages one-by-one for isolation."

            local pkg
            for pkg in "${batch[@]}"; do
                if ! run_as_root env \
                    DEBIAN_FRONTEND=noninteractive \
                    APT_LISTBUGS_FRONTEND=none \
                    APT_LISTCHANGES_FRONTEND=none \
                    NEEDRESTART_MODE=a \
                    apt-get install "${install_flags[@]}" "${pkg}"; then

                    failed+=("${pkg}")
                    log_warn "Package failed to install: ${pkg}"
                fi
            done
        fi

        start="${end}"
    done

    if [ "${#failed[@]}" -gt 0 ]; then
        log_warn "The following packages failed installation:"
        local f
        for f in "${failed[@]}"; do
            log_warn "  - ${f}"
        done
        return 1
    fi

    return 0
}

main() {
    require_binary awk
    require_binary apt-cache
    require_binary apt-get
    require_binary dpkg
    require_binary dpkg-query
    require_binary flock
    require_binary grep
    require_binary sort

    validate_positive_integer "${BATCH_SIZE}" "BATCH_SIZE"
    validate_platform

    if [ "${INSTALL_PROPRIETARY_DRIVERS}" = "1" ]; then
        if ! sources_seem_to_have_nonfree_components; then
            log_warn "INSTALL_PROPRIETARY_DRIVERS=1 but APT sources do not visibly contain contrib/non-free/non-free-firmware."
            log_warn "Firmware/rar/nvidia-driver/etc may appear as 'missing' and will be skipped."
        fi
    fi

    acquire_lock
    apt_update

    local -a package_catalog=()
    local -a available_packages=()
    local -a missing_packages=()
    local -a already_installed=()
    local -a install_queue=()

    mapfile -t package_catalog < <(build_package_catalog | normalize_package_list)

    local package_name
    for package_name in "${package_catalog[@]}"; do
        [ -z "${package_name}" ] && continue

        if package_available "${package_name}"; then
            available_packages+=("${package_name}")

            if package_installed "${package_name}"; then
                already_installed+=("${package_name}")
            else
                install_queue+=("${package_name}")
            fi
        else
            missing_packages+=("${package_name}")
        fi
    done

    log_info "Catalog size: ${#package_catalog[@]} packages."
    log_info "Available in apt metadata: ${#available_packages[@]}"
    log_info "Already installed: ${#already_installed[@]}"
    log_info "Pending install: ${#install_queue[@]}"

    if [ "${#missing_packages[@]}" -gt 0 ]; then
        log_warn "Packages not found in configured repositories (${#missing_packages[@]})."
        local m
        for m in "${missing_packages[@]}"; do
            log_warn "  - ${m}"
        done
        log_warn "Missing packages were skipped automatically."
    fi

    if [ "${#install_queue[@]}" -eq 0 ]; then
        log_info "Nothing to install. System already satisfies the available catalog."
        return 0
    fi

    if install_packages_in_batches "${install_queue[@]}"; then
        log_info "Package installation finished successfully."
    else
        log_warn "Installation completed with failures. Review logs for failed packages."
        exit 1
    fi

    log_info "Running apt autoremove to clean stale dependencies."
    run_as_root env \
        DEBIAN_FRONTEND=noninteractive \
        APT_LISTBUGS_FRONTEND=none \
        APT_LISTCHANGES_FRONTEND=none \
        NEEDRESTART_MODE=a \
        apt-get -y -o Dpkg::Use-Pty=0 autoremove

    log_info "Running apt autoclean."
    run_as_root env \
        DEBIAN_FRONTEND=noninteractive \
        APT_LISTBUGS_FRONTEND=none \
        APT_LISTCHANGES_FRONTEND=none \
        NEEDRESTART_MODE=a \
        apt-get -o Dpkg::Use-Pty=0 autoclean
}

main "$@"
