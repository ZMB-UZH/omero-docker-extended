#!/usr/bin/env bash

set -Eeuo pipefail
IFS=$'\n\t'

SCRIPT_NAME="$(basename "$0")"
LOCK_FILE="/var/lock/${SCRIPT_NAME}.lock"
LOG_PREFIX="[debian-13-extra-packages]"
DRY_RUN="${DRY_RUN:-0}"
ALLOW_NON_TRIXIE="${ALLOW_NON_TRIXIE:-0}"
INSTALL_RECOMMENDS="${INSTALL_RECOMMENDS:-1}"
INSTALL_PROPRIETARY_DRIVERS="${INSTALL_PROPRIETARY_DRIVERS:-1}"
BATCH_SIZE="${BATCH_SIZE:-40}"

log_info() {
    printf '%s INFO: %s\n' "${LOG_PREFIX}" "$*"
}

log_warn() {
    printf '%s WARN: %s\n' "${LOG_PREFIX}" "$*" >&2
}

log_error() {
    printf '%s ERROR: %s\n' "${LOG_PREFIX}" "$*" >&2
}

run_cmd() {
    if [ "${DRY_RUN}" = "1" ]; then
        printf 'DRY_RUN> %s\n' "$*"
        return 0
    fi

    "$@"
}

run_as_root() {
    if [ "$(id -u)" -eq 0 ]; then
        run_cmd "$@"
    else
        if ! command -v sudo >/dev/null 2>&1; then
            log_error "sudo is required when not running as root."
            exit 1
        fi
        run_cmd sudo "$@"
    fi
}

require_binary() {
    local binary_name="$1"

    if ! command -v "${binary_name}" >/dev/null 2>&1; then
        log_error "Missing required command: ${binary_name}"
        exit 1
    fi
}

validate_positive_integer() {
    local value="$1"
    local label="$2"

    if ! [[ "${value}" =~ ^[0-9]+$ ]] || [ "${value}" -eq 0 ]; then
        log_error "${label} must be a positive integer. Received: ${value}"
        exit 1
    fi
}

acquire_lock() {
    if [ "${DRY_RUN}" = "1" ]; then
        log_info "Skipping lock acquisition in DRY_RUN mode."
        return 0
    fi

    run_as_root install -d -m 0755 /var/lock
    exec 9>"${LOCK_FILE}"

    if ! flock -w 30 9; then
        log_error "Could not acquire lock ${LOCK_FILE}; another apt transaction might be active."
        exit 1
    fi
}

validate_platform() {
    local os_id
    local version_id

    if [ ! -r /etc/os-release ]; then
        log_error "Cannot read /etc/os-release."
        exit 1
    fi

    # shellcheck disable=SC1091
    . /etc/os-release

    os_id="${ID:-}"
    version_id="${VERSION_ID:-}"

    if [ "${os_id}" != "debian" ]; then
        log_error "This script only supports Debian. Detected: ${os_id}"
        exit 1
    fi

    if [ "${version_id}" != "13" ] && [ "${ALLOW_NON_TRIXIE}" != "1" ]; then
        log_error "Detected Debian ${version_id}. Set ALLOW_NON_TRIXIE=1 to run outside Debian 13 (Trixie)."
        exit 1
    fi

    if [ "${version_id}" != "13" ] && [ "${ALLOW_NON_TRIXIE}" = "1" ]; then
        log_warn "Running outside Debian 13 because ALLOW_NON_TRIXIE=1 (detected VERSION_ID=${version_id})."
    fi
}

normalize_package_list() {
    awk 'NF {print $1}' | sort -u
}

package_available() {
    local package_name="$1"

    apt-cache show "${package_name}" 2>/dev/null | grep -q '^Package:'
}

package_installed() {
    local package_name="$1"

    dpkg-query -W -f='${Status}' "${package_name}" 2>/dev/null | grep -q 'install ok installed'
}

get_arch() {
    dpkg --print-architecture
}

is_amd64() {
    [ "$(get_arch)" = "amd64" ]
}

# Robust GPU detection without requiring lspci/pciutils.
pci_has_display_vendor() {
    local want_vendor="$1"
    local dev
    local class
    local vendor

    for dev in /sys/bus/pci/devices/*; do
        [ -r "${dev}/class" ] || continue
        [ -r "${dev}/vendor" ] || continue

        class="$(cat "${dev}/class" 2>/dev/null || true)"
        vendor="$(cat "${dev}/vendor" 2>/dev/null || true)"

        # Display controller classes begin with 0x03 (VGA/3D/Display)
        case "${class}" in
            0x03*)
                if [ "${vendor}" = "${want_vendor}" ]; then
                    return 0
                fi
                ;;
        esac
    done

    return 1
}

hardware_has_nvidia() {
    pci_has_display_vendor "0x10de"
}

hardware_has_intel_gpu() {
    pci_has_display_vendor "0x8086"
}

hardware_has_amd_gpu() {
    pci_has_display_vendor "0x1002"
}

sources_seem_to_have_nonfree_components() {
    # Works for both .list and deb822 .sources formats (best-effort grep).
    # We only warn; we do NOT mutate sources.
    if grep -RhsE '(^\s*deb\s+|^\s*Components:\s+).*\<non-free\>|\<non-free-firmware\>|\<contrib\>' \
        /etc/apt/sources.list /etc/apt/sources.list.d 2>/dev/null | grep -qE 'non-free|non-free-firmware|contrib'; then
        return 0
    fi
    return 1
}

