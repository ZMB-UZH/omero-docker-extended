# Critical untracked deployment configuration files.
#
# Every file listed here MUST exist on the deployment host. Automated
# operations (rsync, tree-copy, sync scripts) MUST NOT delete these files.
#
# Run `python3 tools/env_safety_guard.py check` to verify all entries.
# Run `python3 tools/env_safety_guard.py backup` before any destructive operation.
#
# These files are gitignored and contain deployment-specific values
# (paths, credentials, runtime config). They cannot be regenerated
# from the repository alone.

# Docker Compose interpolation paths (bind-mount roots, version pins)
installation_paths.env

# OMERO.web runtime configuration (plugin list, cache, UI layout)
env/omeroweb.env

# OMERO.server runtime configuration (job service, repo sync, cleanse)
env/omeroserver.env

# Secrets: database passwords, OMERO root password, API keys, CrowdSec enroll key
env/omero_secrets.env

# Grafana dashboard configuration
env/grafana.env

# Celery worker and Imaris connector configuration
env/omero-celery.env
