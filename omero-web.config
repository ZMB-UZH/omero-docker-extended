# OMERO.web runtime override file.
#
# Keep OMERO.web file logging on a container-local writable path to avoid
# startup failures when host bind-mounted log directories are root-owned.
#
# Symptom prevented:
#   PermissionError: [Errno 13] Permission denied
#   '/opt/omero/web/OMERO.web/var/log/.__OMEROweb.lock'
#
# The startup script /startup/41-prepare-omero-web-logdir.sh ensures this
# directory exists and is writable before gunicorn starts.
omero.web.logdir=/tmp/omero-web-logs
