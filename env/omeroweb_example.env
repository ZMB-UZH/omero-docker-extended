OMEROHOST=omeroserver
OMERO_PORT=4064
OMERO_WEB_ROOT=/opt/omero/web
OMERO_WEB_HOST_PORT=4090
CONFIG_omero_security_transport=ssl
CONFIG_omero_security_ssl=true
# OMP_HASH_SECRET is defined in env/omero_secrets.env
# FMP_HASH_SECRET is defined in env/omero_secrets.env
OMP_DATA_USER=omero-plugin
# OMP_DATA_PASS is defined in env/omero_secrets.env
OMP_DATA_HOST=database_plugin
OMP_DATA_DB=omero-plugin
OMP_DATA_PORT=5433
# Optional local AI provider overrides. Defaults are http://ollama:11434 and
# qwen2.5:3b when unset.
# OMP_OLLAMA_BASE_URL=http://ollama:11434
# OMP_OLLAMA_MODEL=qwen2.5:3b
CONFIG_omero_web_application__server_port=4090
CONFIG_omero_web_session__cookie__secure=false
CONFIG_omero_web_time__zone=Europe/Zurich
TZ=Europe/Zurich
#
# This MUST match the volume mount in docker-compose.yml.
# The log directory is mounted at /opt/omero/web/OMERO.web/var/log
# and must be writable BEFORE zarr imports during OMERO.web startup.
# ------------------------------------------------------------------
CONFIG_omero_web_logdir=/opt/omero/web/OMERO.web/var/log
#
# Keep Gunicorn runtime artifacts in the writable var tree so Gunicorn 25's
# control socket does not attempt to create files inside read-only site-packages.
# This value is synced into `omero.web.wsgi_args` at startup instead of using
# the deprecated `omero web start --wsgi-args=...` flag.
OMERO_WEB_WSGI_ARGS=--chdir /opt/omero/web/OMERO.web/var/run --timeout 7200
#
# Change the URL based on the actual domain of the reverse proxy. Comment out if no reverse proxy is in use.
# ----------------------------------------------------------------------------------------------------------
#CONFIG_omero_web_csrf__trusted__origins='["https://mydomain.com"]'
#
#
# Redis-backed sessions (recommended over default file-based sessions).
# Sessions survive container recreations and are not lost during cleanup.
# NOTE: In Docker env files, OMERO config dots become underscores and
# underscores become double underscores.
# Example: omero.web.session_engine → CONFIG_omero_web_session__engine
#          omero.web.session_cookie_age → CONFIG_omero_web_session__cookie__age
#
CONFIG_omero_web_session__engine=django.contrib.sessions.backends.cache
CONFIG_omero_web_session__cookie__age=86400
CONFIG_omero_web_session__expire__at__browser__close=false
CONFIG_omero_web_caches={"default":{"BACKEND":"django.core.cache.backends.redis.RedisCache","LOCATION":"redis://redis:6379/1","KEY_PREFIX":"omero","TIMEOUT":86400}}
CONFIG_omero_web_apps=["omero_gallery","omero_figure","omero_fpbioimage","omero_iviewer","omero_mapr","omero_parade","omero_web_zarr","omero_autotag","omero_tagsearch","omero_plugin_common","omeroweb_omp_plugin","omeroweb_import","omeroweb_tools","omeroweb_admin_tools","omeroweb_imaris_connector"]
CONFIG_omero_web_ui_right__plugins=[["Acquisition","webclient/data/includes/right_plugin.acquisition.js.html","metadata_tab"],["Preview","omero_web_zarr/right_plugin.preview.js.html","preview_tab"]]
CONFIG_omero_web_ui_center__plugins=[["Parade","omero_parade/init.js.html","omero_parade"]]
CONFIG_omero_web_open__with=[["Image viewer","webgateway",{"supported_objects":["image"],"script_url":"webclient/javascript/ome.openwith_viewer.js"}],["omero_figure","new_figure",{"supported_objects":["images"],"target":"_blank","label":"OMERO.Figure"}],["omero_iviewer","omero_iviewer_index",{"supported_objects":["images","dataset","well"],"script_url":"omero_iviewer/openwith.js","label":"OMERO viewer"}],["omero_fpbioimage","fpbioimage_index",{"supported_objects":["image"],"script_url":"fpbioimage/openwith.js","label":"FPBioimage"}],["web_zarr_vizarr","omero_web_zarr_index",{"supported_objects":["image"],"label":"Vizarr","script_url":"omero_web_zarr/openwith.js"}]]
CONFIG_omero_web_ui_top__links=[["Data","webindex",{"title":"Browse Data via Projects, Tags etc"}],["Figure","figure_index",{"title":"Open Figure in new tab","target":"_blank"}],["Mapr",{"viewname":"maprindex_anyvalue"},{"title":"Find Any Value"}],["Gallery","/gallery/",{"title":"Open OMERO Gallery","target":"_blank"}],["Tag Search","tagsearch",{"title":"Tag Search"}],["History","history",{"title":"History"}],["Help","https://help.openmicroscopy.org/",{"title":"Open OMERO user guide in a new tab","target":"new"}],["OMP plugin","omeroweb_omp_plugin_index",{"title":"Open OMP plugin in new tab","target":"_blank"}],["Import","omeroweb_import_index",{"title":"Open Import in new tab","target":"_blank"}],["Tools","omeroweb_tools_index",{"title":"Open Tools in new tab","target":"_blank"}],["Admin tools","omeroweb_admin_tools_index",{"title":"Open Admin tools in new tab","target":"_blank"}]]
CONFIG_omero_web_login__logo=/static/branding/logo.png
#
# Storage quota enforcement
# -------------------------
ADMIN_TOOLS_QUOTA_RECONCILE_INTERVAL_SECONDS=60
# Minimum allowed quota value in GB (UI validation + backend validation + ext4 enforcer)
ADMIN_TOOLS_MIN_QUOTA_GB=0.10
# Default quota value in GB automatically assigned to new OMERO groups
ADMIN_TOOLS_DEFAULT_GROUP_QUOTA_GB=0.10
# Set true to auto-create per-group quota entries for new OMERO groups
ADMIN_TOOLS_AUTO_SET_DEFAULT_GROUP_QUOTA=false
#
# Quota state file – MUST be on the shared /OMERO volume so the host-side
# systemd enforcer can read it.  Default: /OMERO/.admin-tools/group-quotas.json
# ADMIN_TOOLS_QUOTA_STATE_PATH=/OMERO/.admin-tools/group-quotas.json
#
# ext4 project-quota mapping files (used by the host-side enforcer only)
# ----------------------------------------------------------------------
ADMIN_TOOLS_QUOTA_PROJECTS_FILE=/OMERO/.admin-tools/quota/projects
ADMIN_TOOLS_QUOTA_PROJID_FILE=/OMERO/.admin-tools/quota/projid
ADMIN_TOOLS_QUOTA_PROJECT_ID_MIN=200000
#
ADMIN_TOOLS_LOKI_URL=http://loki:3100
ADMIN_TOOLS_LOG_LOOKBACK_SECONDS=3600
ADMIN_TOOLS_LOG_MAX_ENTRIES=5000
ADMIN_TOOLS_LOG_REQUEST_TIMEOUT_SECONDS=30
ADMIN_TOOLS_LOG_CACHE_MAX_MB=1024
ADMIN_TOOLS_LOG_INTERNAL_FILE_BATCH_SIZE=12
ADMIN_TOOLS_LOG_MAX_PARALLEL_QUERIES=4
ADMIN_TOOLS_OMERO_SERVER_HOST=omeroserver
ADMIN_TOOLS_OMERO_BLITZ_PORT=4064
ADMIN_TOOLS_OMERO_SECURE_PORT=4063
ADMIN_TOOLS_OMERO_WEB_HOST=omeroweb
ADMIN_TOOLS_OMERO_WEB_PATH=/webclient/
#
ADMIN_TOOLS_GRAFANA_URL=http://grafana:3000
ADMIN_TOOLS_GRAFANA_DASHBOARD_UID=omero-infrastructure
ADMIN_TOOLS_GRAFANA_DASHBOARD_SLUG=server-infrastructure
ADMIN_TOOLS_PROMETHEUS_URL=http://prometheus:9090
#
TOOLS_ENHANCED_SEARCH_INDEX_BATCH_SIZE=100
TOOLS_ENHANCED_SEARCH_MAX_RESULTS=50
TOOLS_ENHANCED_SEARCH_SYNC_STALE_SECONDS=600
TOOLS_ENHANCED_SEARCH_SCHEMA_VERSION=1
#
OMERO_WEB_UPLOAD_CONCURRENCY=3
OMERO_WEB_UPLOAD_BATCH_FILES=5
OMERO_WEB_UPLOAD_CLI_KEEPALIVE_SECONDS=30
OMERO_WEB_UPLOAD_SCRIPT_START_TIMEOUT_SECONDS=180
OMERO_WEB_UPLOAD_SCRIPT_START_RETRY_SECONDS=5
OMERO_WEB_UPLOAD_LOCAL_SCAN_TIMEOUT_SECONDS=7200
OMERO_WEB_UPLOAD_IMPORT_TIMEOUT_SECONDS=86400
OMERO_WEB_UPLOAD_NATIVE_ZARR_GZIP_LEVEL=1
OMERO_WEB_UPLOAD_FAILED_IMPORT_RETENTION_SECONDS=172800
# Enable alternative zarr import method for Bio-Formats-incompatible .zarr
# files.  When true, incompatible zarrs are imported via native omero-cli-zarr.
# When false, only the standard Bio-Formats import path is used and
# incompatible zarr files are skipped.
OMERO_WEB_UPLOAD_ALTERNATIVE_ZARR_IMPORT=false
OMERO_WEB_UPLOAD_DISABLE_SPECIAL_METHODS=false
#
# Enable alternative zarr rendering overrides that patch OMERO's built-in
# rendering, preview, and pyramid handling for zarr images.  When false,
# OMERO's default built-in rendering pipeline (iviewer, Vizarr, webgateway)
# applies without any zarr-specific patches.
OMERO_WEB_ZARR_ALTERNATIVE_RENDERING=false
#
CONFIG_omero_web_debug=true
OMERO_WEB_VENV=venv-3.12
#
