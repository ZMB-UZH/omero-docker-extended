# Main OMERO PostgreSQL (service: database)
#------------------------------------------
OMERO_DB_PASS=
#
# Plugin PostgreSQL (service: database_plugin)
# --------------------------------------------
OMP_PLUGIN_DB_PASS=
OMP_DATA_PASS=
#
# OMERO root user password
# ------------------------
ROOTPASS=
#
# Job service user password
# -------------------------
OMERO_JOB_SERVICE_PASS=
OMERO_WEB_JOB_SERVICE_PASS=
#
# Plugin hashes
# -------------
OMP_HASH_SECRET=
FMP_HASH_SECRET=
#
# Grafana admin password
# ----------------------
GF_SECURITY_ADMIN_PASSWORD=
#
# Crowdsec
# Navigate to https://app.crowdsec.net/security-engines?distribution=linux
# click "Enroll command" and copy only the token (e.g., cmm1sivky0...).
# On installation runs with a real CrowdSec enroll key, OMERO requests
# CrowdSec dashboard approval again and schedules one non-blocking CrowdSec
# restart about 10 minutes after CrowdSec first starts in that install run.
# Leave the enrolment key empty to skip console enrollment.
CROWDSEC_ENROLL_KEY=
CROWDSEC_ENGINE_NAME=
#
# LDAP bind and directory settings (required when LDAP is enabled, except user filter).
# Enable LDAP in env/omeroserver.env by setting CONFIG_omero_ldap_config=true.
# ----------------------------------------------------------------------------
# CONFIG_omero_ldap_urls=
# CONFIG_omero_ldap_username=
# CONFIG_omero_ldap_password=
# CONFIG_omero_ldap_base=
# CONFIG_omero_ldap_user__filter=  # optional
#
