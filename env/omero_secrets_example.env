# Credential placeholders only. Fill env/omero_secrets.env on the host and
# keep it out of Git, shared logs, and release artifacts.

# Main PostgreSQL password
OMERO_DB_PASS=

# Plugin PostgreSQL passwords
# Use matching credentials for the database and plugin client unless you have
# configured a separate database role.
OMP_PLUGIN_DB_PASS=
OMP_DATA_PASS=

# OMERO administrator
ROOTPASS=

# Job service credentials
# Use matching passwords for the server and web job-service accounts.
OMERO_JOB_SERVICE_PASS=
OMERO_WEB_JOB_SERVICE_PASS=

# Plugin signing keys
OMP_HASH_SECRET=
FMP_HASH_SECRET=

# Grafana administrator
GF_SECURITY_ADMIN_PASSWORD=

# Optional CrowdSec Console enrollment
# Leave the key empty to skip enrollment. If enabled, accept the request in the Console.
CROWDSEC_ENROLL_KEY=
CROWDSEC_ENGINE_NAME=

# Optional LDAP connection
# Enable LDAP in env/omeroserver.env after configuring the LDAP bind and search settings.
# CONFIG_omero_ldap_urls=
# CONFIG_omero_ldap_username=
# CONFIG_omero_ldap_password=
# CONFIG_omero_ldap_base=
# CONFIG_omero_ldap_user__filter=  # optional
