# Main OMERO PostgreSQL (service: database)
#------------------------------------------
OMERO_DB_PASS=CHANGEPASSWORD1
#
# Plugin PostgreSQL (service: database_plugin)
# --------------------------------------------
OMP_PLUGIN_DB_PASS=CHANGEPASSWORD2
OMP_DATA_PASS=CHANGEPASSWORD2
#
# OMERO root user password
# ------------------------
ROOTPASS=CHANGEPASSWORD3
#
# Job service user password
# -------------------------
OMERO_JOB_SERVICE_PASS=CHANGEPASSWORD4
OMERO_WEB_JOB_SERVICE_PASS=CHANGEPASSWORD4
#
# Plugin hashes
# -------------
OMP_HASH_SECRET=CHANGEVALUE1
FMP_HASH_SECRET=CHANGEVALUE1
#
# Grafana admin password
# ----------------------
GF_SECURITY_ADMIN_PASSWORD=CHANGEPASSWORD5
#
# Local supervisord control socket credentials (omeroweb container)
# -----------------------------------------------------------------
SUPERVISOR_USERNAME=CHANGEVALUE2
SUPERVISOR_PASSWORD=CHANGEPASSWORD6
#
# Crowdsec
# Navigate to https://app.crowdsec.net/security-engines?distribution=linux
# click "Enroll command" and copy only the token (e.g., cmm1sivky0...).
# On installation runs with a real CrowdSec enroll key, OMERO requests
# CrowdSec dashboard approval again and schedules one non-blocking CrowdSec
# restart about 10 minutes after CrowdSec first starts in that install run.
# Leave the enrolment key empty to skip console enrollment.
CROWDSEC_ENROLL_KEY=CHANGEVALUE3
CROWDSEC_ENGINE_NAME=CHANGEVALUE4
#
# LDAP bind and directory settings (required when LDAP is enabled, except user filter).
# Enable LDAP in env/omeroserver.env by setting CONFIG_omero_ldap_config=true.
# ----------------------------------------------------------------------------
# CONFIG_omero_ldap_urls=CHANGEVALUE5
# CONFIG_omero_ldap_username=CHANGEVALUE6
# CONFIG_omero_ldap_password=CHANGEPASSWORD7
# CONFIG_omero_ldap_base=CHANGEVALUE7
# CONFIG_omero_ldap_user__filter=CHANGEVALUE8  # optional
#
