# Main OMERO PostgreSQL (service: database)
#------------------------------------------
OMERO_DB_PASS=CHANGEME1
#
# Plugin PostgreSQL (service: database_plugin)
# --------------------------------------------
OMP_PLUGIN_DB_PASS=CHANGEME2
OMP_DATA_PASS=CHANGEME2
#
# OMERO root user password
# ------------------------
ROOTPASS=CHANGEME3
#
# Job service user password
# -------------------------
OMERO_JOB_SERVICE_PASS=CHANGEME4
OMERO_WEB_JOB_SERVICE_PASS=CHANGEME4
#
# Plugin hashes
# -------------
OMP_HASH_SECRET=CHANGEME5
FMP_HASH_SECRET=CHANGEME5
#
# Grafana admin password
# ----------------------
GF_SECURITY_ADMIN_PASSWORD=CHANGEME6
#
# LDAP bind and directory settings (required when LDAP is enabled).
# Enable LDAP in env/omeroserver.env by setting CONFIG_omero_ldap_config=true.
# ----------------------------------------------------------------------------
CONFIG_omero_ldap_urls=ldaps://ad1.example.org:636
CONFIG_omero_ldap_username=CN=ldap-bind-user,OU=ServiceAccounts,DC=example,DC=org
CONFIG_omero_ldap_password=CHANGEME7
CONFIG_omero_ldap_base=DC=example,DC=org
CONFIG_omero_ldap_user_filter=(|(memberOf=CN=GroupA,OU=Groups,DC=example,DC=org)(memberOf=CN=GroupB,OU=Groups,DC=example,DC=org))
#
