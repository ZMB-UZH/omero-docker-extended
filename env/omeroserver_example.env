CONFIG_omero_host=omeroserver
#
CONFIG_omero_db_host=database
CONFIG_omero_db_user=omero
# CONFIG_omero_db_pass is defined in env/omero_secrets.env
CONFIG_omero_db_name=omero
# ROOTPASS is defined in env/omero_secrets.env
TZ=Europe/Zurich
#
OMERO_CLI_USER=omero-server
OMERO_CLI_HOST=localhost
OMERO_CLI_PORT=4064
OMERO_SERVER_HOST_PORT=4064
OMERO_SERVER_HEALTHCHECK_INTERVAL_SECONDS=30
OMERO_SERVER_HEALTHCHECK_TIMEOUT_SECONDS=60
OMERO_SERVER_HEALTHCHECK_RETRIES=80
OMERO_SERVER_HEALTHCHECK_START_PERIOD_SECONDS=1200
#
OMERO_JOB_SERVICE_USERNAME=job-service
# OMERO_JOB_SERVICE_PASS is defined in env/omero_secrets.env
OMERO_JOB_SERVICE_JOIN_ALL_GROUPS=1
OMERO_JOB_SERVICE_HOST=localhost
OMERO_JOB_SERVICE_PORT=4064
OMERO_JOB_SERVICE_STARTUP_WAIT_SECONDS=900
OMERO_JOB_SERVICE_READINESS_POLL_SECONDS=10
OMERO_JOB_SERVICE_USER_ENSURE_RETRIES=3
OMERO_JOB_SERVICE_SYNC_INTERVAL_SECONDS=3600
OMERO_JOB_SERVICE_SYNC_MAX_RETRIES=3
OMERO_JOB_SERVICE_SYNC_JITTER_SECONDS=20
OMERO_JOB_SERVICE_SECURE=true
#
# Managed-repository shared-prefix ownership sync.
# Keeps the %group% prefixes before %user% owned by root for all current and future groups.
# -----------------------------------------------------------------------------------------
OMERO_REPO_ROOT_SYNC_INTERVAL_SECONDS=3600
OMERO_REPO_ROOT_SYNC_JITTER_SECONDS=20
#
# Automatic orphan-binary cleanup for the OMERO binary repository.
# Runs in the background after OMERO.server is reachable on each container start.
# -------------------------------------------------------------------------------
OMERO_BINARY_REPO_CLEANSE_ON_START=1
OMERO_BINARY_REPO_CLEANSE_DATA_DIR=/OMERO
OMERO_BINARY_REPO_CLEANSE_STARTUP_WAIT_SECONDS=900
OMERO_BINARY_REPO_CLEANSE_READINESS_POLL_SECONDS=10
OMERO_BINARY_REPO_CLEANSE_KEEPALIVE_SECONDS=30
OMERO_REPOSITORY_LOCK_CLEANUP_ON_START=1
#
# Purge rendering caches on container start: pyramid files, Bio-Formats
# memo cache, and thumbnail cache.  All regenerate automatically when
# users access their images.  No original data is deleted.
# Safe only when OMERO_ZARR_PIXEL_BUFFER_ENABLED=false (the default),
# because the standard PixelsService handles pyramid regeneration.
# Recommended after disabling alternative zarr mechanisms.
# Reset to 0 after one successful cleanup cycle.
# -----------------------------------------------------------------------
OMERO_RENDERING_CACHE_CLEANUP_ON_START=0
#
CONFIG_omero_security_login__failure__throttle__count=5
CONFIG_omero_security_login__failure__throttle__time=60000
#
# LDAP toggle and new-user group mapping.
# Keep all lines below commented out unless all LDAP credentials are provided in env/omero_secrets.env.
# -----------------------------------------------------------------------------------------------------
# CONFIG_omero_ldap_config=true
# CONFIG_omero_ldap_new__user__group=users_ldap
# CONFIG_omero_security_ignore__case=true
#
# Installation-time group creation
# --------------------------------
OMERO_INSTALL_GROUP_LIST=users_ldap:private,users_private:private,users_read:read-only,users_collaboration:read-annotate,users_readwrite:read-write
#
CONFIG_omero_db_poolsize=100
JAVA_OPTS=-Xmx3G -Djava.io.tmpdir=/var/tmp
CONFIG_omero_scripts_processors=20
# Official OMERO config glossary:
# https://omero.readthedocs.io/en/stable/sysadmins/config.html
CONFIG_omero_pixeldata_threads=4
#
# Managed repository import parent directory template
# CRITICAL: CONFIG_omero_managed_dir MUST be an absolute path inside
# ${OMERO_DATA_DIR}.  A relative value (e.g. "ManagedRepository") causes
# OMERO to resolve the path against its server install directory, placing
# imported files in the container's ephemeral filesystem where they are
# lost on restart.  The startup guard in 10-server-bootstrap.sh will
# refuse to start the server if this path is relative or outside OMERO_DIR.
# ---------------------------------------------------
CONFIG_omero_managed_dir=/OMERO/ManagedRepository
CONFIG_omero_fs_repo_path=%group%/%user%/%year%-%month%-%day%/%time%
#
# OMERO.dropbox configuration.
# The DropBox acceptor root is CONFIG_omero_fs_watchDir when set; otherwise
# OMERO resolves CONFIG_omero_fs_defaultDropBoxDir below omero.data.dir.
# Keep CONFIG_omero_fs_importUsers=default for the supported convention:
# <DropBox root>/<omero username>/...
# -----------------------------------------------------------------------
OMERO_DROPBOX_ENABLED=1
OMERO_DROPBOX_VERSION=5.7.0
OMERO_DROPBOX_ICE_BOOTSTRAP_STARTUP_WAIT_SECONDS=900
OMERO_DROPBOX_ICE_BOOTSTRAP_READINESS_POLL_SECONDS=10
OMERO_DROPBOX_ICE_BOOTSTRAP_MAX_RETRY_SECONDS=3600
CONFIG_omero_fs_host=localhost
CONFIG_omero_fs_port=4064
CONFIG_omero_fs_maxRetries=5
CONFIG_omero_fs_retryInterval=3
CONFIG_omero_fs_defaultDropBoxDir=DropBox
CONFIG_omero_fs_platformCheck=True
CONFIG_omero_fs_importUsers=default
CONFIG_omero_fs_watchDir=
CONFIG_omero_fs_eventTypes=Creation,Modification
CONFIG_omero_fs_pathMode=Follow
CONFIG_omero_fs_whitelist=
CONFIG_omero_fs_blacklist=
CONFIG_omero_fs_timeout=0.0
CONFIG_omero_fs_timeToLive=0
CONFIG_omero_fs_timeToIdle=600
CONFIG_omero_fs_blockSize=0
CONFIG_omero_fs_ignoreSysFiles=True
CONFIG_omero_fs_ignoreDirEvents=True
CONFIG_omero_fs_dirImportWait=600
CONFIG_omero_fs_fileBatch=10
CONFIG_omero_fs_throttleImport=10
CONFIG_omero_fs_readers=
CONFIG_omero_fs_importArgs=
CONFIG_omero_fs_serverIdString=MonitorServer
CONFIG_omero_fs_clientIdString=DropBox
CONFIG_omero_fs_clientAdapterName=omerofs.DropBox
#
# DropBox per-user directory synchronization.
# Empty owner/group values inherit the resolved DropBox root owner/group. Set
# numeric IDs or names here only when your external filesystem mapping requires
# them. Mode 2775 keeps the group sticky for externally created subdirectories.
# -------------------------------------------------------------------------
OMERO_DROPBOX_USER_DIR_SYNC_ENABLED=1
OMERO_DROPBOX_USER_DIR_SYNC_INTERVAL_SECONDS=3600
OMERO_DROPBOX_USER_DIR_SYNC_JITTER_SECONDS=20
OMERO_DROPBOX_USER_DIR_SYNC_STARTUP_WAIT_SECONDS=900
OMERO_DROPBOX_USER_DIR_SYNC_READINESS_POLL_SECONDS=10
OMERO_DROPBOX_USER_DIR_SYNC_MAX_RETRIES=3
OMERO_DROPBOX_USER_DIR_SYNC_OMERO_HOST=localhost
OMERO_DROPBOX_USER_DIR_SYNC_OMERO_PORT=4064
OMERO_DROPBOX_USER_DIR_SYNC_OMERO_SECURE=true
OMERO_DROPBOX_USER_DIR_SYNC_OMERO_USERNAME=root
OMERO_DROPBOX_USER_DIR_SYNC_OMERO_PASSWORD_ENV=ROOTPASS
OMERO_DROPBOX_USER_DIR_CREATE_ROOT=1
OMERO_DROPBOX_USER_DIR_OWNER=
OMERO_DROPBOX_USER_DIR_GROUP=
OMERO_DROPBOX_USER_DIR_MODE=2775
OMERO_DROPBOX_USER_DIR_ALLOW_WORLD_WRITABLE=0
#
# Enable automatic registration of official OMERO scripts.
# This ensures Figure Export to PDF and other official scripts are available.
# ---------------------------------------------------------------------------
REGISTER_OFFICIAL_SCRIPTS=1
#
# OMERO.Figure version: change accordingly if there is a warning in OMERO.web Figure Export to PDF script
# https://github.com/ome/omero-figure/releases
# --------------------------------------------
OMERO_FIGURE_VERSION=7.4.1
#
# OMERO downloader version: align with desired OMERO downloader release
# https://github.com/ome/omero-downloader/releases
# ------------------------------------------------
OMERO_DOWNLOADER_VERSION=0.3.3
#
# OMEZarrReader version: Bio-Formats plugin for reading OME-NGFF zarrs
# https://github.com/ome/ZarrReader/releases
# ---------------------------------------------------------------------
OMEZARR_READER_VERSION=0.6.0
#
# JZarr version: Java zarr library used by OMEZarrReader
# https://repo1.maven.org/maven2/dev/zarr/jzarr/
# ---------------------------------------------------
JZARR_VERSION=0.4.2
#
# omero-zarr-pixel-buffer version: server-side plugin for serving zarr pixel data
# https://github.com/glencoesoftware/omero-zarr-pixel-buffer/releases
# ---------------------------------------------------------------------------------
OMERO_ZARR_PIXEL_BUFFER_VERSION=0.6.1
#
# Enable the omero-zarr-pixel-buffer server-side plugin at runtime.
# When false, the plugin JAR is moved out of the classpath so the standard
# OMERO PixelsService handles all pixel buffer requests (including pyramid
# regeneration).  Must be true when alternative zarr import or rendering
# mechanisms are enabled.  Default false.
# -----------------------------------------------------------------------
OMERO_ZARR_PIXEL_BUFFER_ENABLED=false
#
# omero-cli-zarr version: CLI tool for importing OME-NGFF zarrs into OMERO
# https://github.com/ome/omero-cli-zarr/releases
# -----------------------------------------------------------------------
OMERO_CLI_ZARR_VERSION=0.8.0
#
# ome-zarr Python package version: authoritative OME-Zarr reader/metadata layer
# for native import routing when Bio-Formats cannot read a staged .zarr store
# https://github.com/ome/ome-zarr-py
# -------------------------------------------------------------------------------
OME_ZARR_PY_VERSION=0.16.0
#
# bioformats2raw version: converter runtime used by native Zarr import support
# and the NGFF conversion workflow
# https://github.com/glencoesoftware/bioformats2raw/releases
# --------------------------------------------------------------------------
BIOFORMATS2RAW_VERSION=0.11.0
#
# Bio-Formats version: ome/bioformats release used by ImarisConvertBioformats
# and IMS_Export.py (bioformats_package.jar)
# https://github.com/ome/bioformats/releases
# ---------------------------------------------------------------------------
BIOFORMATS_VERSION=8.5.0
#
# Default IMS export directory (mounted under /OMERO)
# ---------------------------------------------------
OMERO_IMS_EXPORT_DIR=/OMERO/ImarisExports
#
