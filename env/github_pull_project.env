# Path overrides for github_pull_project_bash_example.
#
# This file is optional. If present, it is sourced by the script before prompts,
# allowing users to define default paths without editing script code.

# Root installation directory used by the github pull workflow.
OMERO_INSTALLATION_PATH=/opt/omero/

# Host path for OMERO database persistent data.
OMERO_DATABASE_PATH=/opt/omero/omero_data/database

# Host path for OMP plugin database persistent data.
OMERO_PLUGIN_DATABASE_PATH=/opt/omero/omero_data/plugin_database
