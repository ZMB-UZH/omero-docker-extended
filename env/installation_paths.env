# Default installation paths for github_pull_project_bash
# This file is the single source of truth for all default installation paths
#
# Required variables:
#   OMERO_INSTALLATION_PATH
#   OMERO_DATABASE_PATH
#   OMERO_PLUGIN_DATABASE_PATH

OMERO_INSTALLATION_PATH=/opt/omero/
OMERO_DATABASE_PATH=/opt/omero/postgresdb/database
OMERO_PLUGIN_DATABASE_PATH=/opt/omero/postgresdb/plugin_database
