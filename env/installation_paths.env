# Required installation paths for github_pull_project_bash_example.
#
# This file is the single source of truth for installation and data paths.
# The script fails fast if any required variable is missing or invalid.
#
# Required variables:
#   OMERO_INSTALLATION_PATH
#   OMERO_DATABASE_PATH
#   OMERO_PLUGIN_DATABASE_PATH

OMERO_INSTALLATION_PATH=/opt/omero/
OMERO_DATABASE_PATH=/opt/omero/omero_data/database
OMERO_PLUGIN_DATABASE_PATH=/opt/omero/omero_data/plugin_database
